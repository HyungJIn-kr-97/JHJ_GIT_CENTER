<Project>
  <PropertyGroup>
    <!-- 계약: 배포 버전 = VersionPrefix(major.minor.patch), 개발 빌드 = 배포 버전.<빌드 날짜> — 체계는 README 「버전 체계」 -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.0.4</VersionPrefix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>
    <!-- 함정: Assembly/FileVersion 의 각 자리는 65534 가 상한이라 20261009 를 못 담는다 — 날짜는 InformationalVersion 에만 둔다 -->
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::Now.ToString('yyyyMMdd'))</BuildDate>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$([System.Version]::Parse('$(VersionPrefix).0'))</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$([System.Version]::Parse('$(VersionPrefix).0'))</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(VersionPrefix).$(BuildDate)</InformationalVersion>

    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- 단일 파일 게시에 맞춰 심볼은 어셈블리에 박고 pdb 는 내보내지 않는다 -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
</Project>
