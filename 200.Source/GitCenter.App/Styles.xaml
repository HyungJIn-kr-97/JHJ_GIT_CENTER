<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:GitCenter.App">

    <!--
      이 앱의 디자인 체계 한 곳 — 창 XAML 은 여기 정의된 Style·Brush 만 쓴다.

      계약: 색은 전부 DynamicResource 다 — ThemeManager 가 실행 중에 갈아 끼운다.
      계약: 둥근 모서리는 다섯 값뿐이다 — 입력·단추 RadiusSm(6) · 카드 RadiusMd(10) · 알약 Pill(16)·PillSm(9)·PillXs(3).
      왜: Windows 기본 ScrollBar·CheckBox·ComboBox 는 어두운 테마에서 밝은 회색으로 남아 바탕과 어긋난다
          — 세 가지 모두 템플릿을 새로 씌운다. JHJ_AI_USAGE 와 같은 결이다.
      함정: 글상자의 안내 문구는 트리거가 아니라 바인딩으로 켠다 — DataTrigger 는 켜지지 않았다(2026-10-09 실측).
    -->

    <local:StateBrushConverter x:Key="StateBrush" />
    <local:OutcomeBrushConverter x:Key="OutcomeBrush" />
    <local:ChangeKindConverter x:Key="ChangeKind" />
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    <local:CountToVisibilityConverter x:Key="CountToVisibility" />
    <local:NullToVisibilityConverter x:Key="NullToVisibility" />
    <local:NullToBoolConverter x:Key="NullToBool" />
    <local:LinesConverter x:Key="Lines" />
    <local:ThemeLabelConverter x:Key="ThemeLabel" />
    <local:PaletteLabelConverter x:Key="PaletteLabel" />
    <local:PaletteSwatchConverter x:Key="PaletteSwatch" />
    <local:IconChoiceLabelConverter x:Key="IconChoiceLabel" />
    <local:IconChoicePreviewConverter x:Key="IconChoicePreview" />
    <local:LanguageLabelConverter x:Key="LanguageLabel" />
    <local:ScaleLabelConverter x:Key="ScaleLabel" />
    <local:RowStyleConverter x:Key="RowStyle" />
    <local:DiffBackConverter x:Key="DiffBack" />
    <local:DiffForeConverter x:Key="DiffFore" />
    <local:DiffSignConverter x:Key="DiffSign" />
    <local:IndexToVisibilityConverter x:Key="IndexToVisibility" />
    <local:IndexToBoolConverter x:Key="IndexToBool" />

    <!-- ── 글꼴·치수 ─────────────────────────────────────────── -->

    <!-- 왜: Pretendard 가 깔린 PC 에서는 그것을, 아니면 Windows 11 기본 글꼴로 떨어진다 — JHJ_AI_USAGE 와 같은 차례다 -->
    <FontFamily x:Key="UiFont">Pretendard Variable, Pretendard, Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, D2Coding, Segoe UI Mono</FontFamily>

    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <!-- 함정: 알약을 999 로 주면 WPF 가 가로까지 둥글려 타원이 된다 — 그 칸 높이의 절반을 적는다 -->
    <CornerRadius x:Key="Pill">16</CornerRadius>
    <CornerRadius x:Key="PillSm">9</CornerRadius>
    <CornerRadius x:Key="PillXs">3</CornerRadius>

    <sys:Double x:Key="FontXs">11</sys:Double>
    <sys:Double x:Key="FontSm">12</sys:Double>
    <sys:Double x:Key="FontMd">13</sys:Double>
    <sys:Double x:Key="FontLg">15</sys:Double>
    <sys:Double x:Key="FontXl">19</sys:Double>
    <!-- 계약: 대시보드의 큰 숫자 한 곳에만 쓴다 -->
    <sys:Double x:Key="FontHero">28</sys:Double>

    <!-- ── 아이콘 — 24×24 좌표계의 선 도형(Lucide 계열을 본떠 직접 그린 것) ── -->

    <Geometry x:Key="IconSearch">M11,4 A7,7 0 1,1 11,18 A7,7 0 1,1 11,4 M16,16 L21,21</Geometry>
    <Geometry x:Key="IconRefresh">M20,11 A8,8 0 1,0 18.5,16 M20,5 L20,11 L14,11</Geometry>
    <Geometry x:Key="IconScan">M3,8 L3,5 A2,2 0 0,1 5,3 L8,3 M16,3 L19,3 A2,2 0 0,1 21,5 L21,8 M21,16 L21,19 A2,2 0 0,1 19,21 L16,21 M8,21 L5,21 A2,2 0 0,1 3,19 L3,16 M3,12 L21,12</Geometry>
    <Geometry x:Key="IconGear">M12,15.5 A3.5,3.5 0 1,1 12,8.5 A3.5,3.5 0 1,1 12,15.5 M19.4,15 L20.9,16.2 L19.4,18.8 L17.6,18.2 A7.3,7.3 0 0,1 15.4,19.5 L15,21.4 L12,21.4 L9,21.4 L8.6,19.5 A7.3,7.3 0 0,1 6.4,18.2 L4.6,18.8 L3.1,16.2 L4.6,15 A7.4,7.4 0 0,1 4.6,9 L3.1,7.8 L4.6,5.2 L6.4,5.8 A7.3,7.3 0 0,1 8.6,4.5 L9,2.6 L15,2.6 L15.4,4.5 A7.3,7.3 0 0,1 17.6,5.8 L19.4,5.2 L20.9,7.8 L19.4,9 A7.4,7.4 0 0,1 19.4,15</Geometry>
    <Geometry x:Key="IconBranch">M6,5 A2,2 0 1,1 6,9 A2,2 0 1,1 6,5 M6,9 L6,19 M18,5 A2,2 0 1,1 18,9 A2,2 0 1,1 18,5 M18,9 A6,6 0 0,1 12,15 L6,15</Geometry>
    <Geometry x:Key="IconFolder">M3,7 L3,19 A1,1 0 0,0 4,20 L20,20 A1,1 0 0,0 21,19 L21,9 A1,1 0 0,0 20,8 L12,8 L10,5 L4,5 A1,1 0 0,0 3,6 Z</Geometry>
    <Geometry x:Key="IconTerminal">M5,7 L10,12 L5,17 M12,17 L19,17</Geometry>
    <Geometry x:Key="IconCode">M8,6 L3,12 L8,18 M16,6 L21,12 L16,18</Geometry>
    <Geometry x:Key="IconDownload">M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20</Geometry>
    <Geometry x:Key="IconLink">M10,14 A4,4 0 0,0 15.7,14 L18.5,11.2 A4,4 0 0,0 12.8,5.5 L11.5,6.8 M14,10 A4,4 0 0,0 8.3,10 L5.5,12.8 A4,4 0 0,0 11.2,18.5 L12.5,17.2</Geometry>
    <Geometry x:Key="IconUpload">M12,16 L12,4 M7,9 L12,4 L17,9 M5,20 L19,20</Geometry>
    <Geometry x:Key="IconExternal">M14,4 L20,4 L20,10 M20,4 L11,13 M18,14 L18,19 A1,1 0 0,1 17,20 L5,20 A1,1 0 0,1 4,19 L4,7 A1,1 0 0,1 5,6 L10,6</Geometry>
    <Geometry x:Key="IconDesktop">M4,5 L20,5 A1,1 0 0,1 21,6 L21,16 A1,1 0 0,1 20,17 L4,17 A1,1 0 0,1 3,16 L3,6 A1,1 0 0,1 4,5 Z M8,21 L16,21</Geometry>
    <Geometry x:Key="IconCheck">M4.5,12.5 L9,17 L19.5,6.5</Geometry>
    <Geometry x:Key="IconChevronDown">M6,9.5 L12,15.5 L18,9.5</Geometry>
    <Geometry x:Key="IconChevronRight">M9.5,6 L15.5,12 L9.5,18</Geometry>
    <Geometry x:Key="IconChevronLeft">M14.5,6 L8.5,12 L14.5,18</Geometry>
    <Geometry x:Key="IconGrid">M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z</Geometry>
    <Geometry x:Key="IconList">M9,6 L20,6 M9,12 L20,12 M9,18 L20,18 M4.5,6 L4.6,6 M4.5,12 L4.6,12 M4.5,18 L4.6,18</Geometry>
    <Geometry x:Key="IconCopy">M9,9 L19,9 A1,1 0 0,1 20,10 L20,20 A1,1 0 0,1 19,21 L9,21 A1,1 0 0,1 8,20 L8,10 A1,1 0 0,1 9,9 Z M5,15 L4,15 A1,1 0 0,1 3,14 L3,4 A1,1 0 0,1 4,3 L14,3 A1,1 0 0,1 15,4 L15,5</Geometry>
    <Geometry x:Key="IconSort">M7,5 L7,19 M3.5,15.5 L7,19 L10.5,15.5 M17,19 L17,5 M13.5,8.5 L17,5 L20.5,8.5</Geometry>
    <Geometry x:Key="IconExpandAll">M7,9 L12,14 L17,9 M7,14 L12,19 L17,14 M5,5 L19,5</Geometry>
    <Geometry x:Key="IconCollapseAll">M7,15 L12,10 L17,15 M7,10 L12,5 L17,10 M5,19 L19,19</Geometry>
    <Geometry x:Key="IconDown">M12,4 L12,19 M5.5,12.5 L12,19 L18.5,12.5</Geometry>
    <Geometry x:Key="IconUp">M12,20 L12,5 M5.5,11.5 L12,5 L18.5,11.5</Geometry>
    <Geometry x:Key="IconMerge">M6,4 A2,2 0 1,1 6,8 A2,2 0 1,1 6,4 M6,8 L6,20 M18,10 A2,2 0 1,1 18,14 A2,2 0 1,1 18,10 M16,12 L6,12</Geometry>
    <Geometry x:Key="IconUndo">M4,9 L9,9 L9,4 M4.5,9.5 A7.5,7.5 0 1,1 6,15</Geometry>
    <Geometry x:Key="IconStop">M8,8 L16,8 L16,16 L8,16 Z</Geometry>
    <Geometry x:Key="IconHide">M3,12 C6,7 9,5 12,5 C15,5 18,7 21,12 C18,17 15,19 12,19 C9,19 6,17 3,12 Z M4,4 L20,20</Geometry>

    <!-- 창 단추 — Windows 기본 제목 표시줄을 떼고 직접 그린다 -->
    <Geometry x:Key="IconMinimize">M5,12.5 L19,12.5</Geometry>
    <Geometry x:Key="IconMaximize">M5.5,5.5 L18.5,5.5 L18.5,18.5 L5.5,18.5 Z</Geometry>
    <Geometry x:Key="IconRestore">M8,8 L8,5.5 L18.5,5.5 L18.5,16 L16,16 M5.5,8 L16,8 L16,18.5 L5.5,18.5 Z</Geometry>
    <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>

    <!-- ── 글자 ─────────────────────────────────────────────── -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontMd}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
    </Style>

    <Style x:Key="Micro" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontXs}" />
    </Style>

    <!-- 계약: 구역 이름 — 작고 굵고 자간을 띄운 대문자 결. 카드마다 맨 위 한 줄 -->
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontXs}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontXl}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Subtitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
    </Style>

    <!-- ── 스크롤바 — 얇은 둥근 막대 하나로 통일 ───────────────── -->

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Margin="1"
                            Background="{DynamicResource TextFaintBrush}" Opacity="0.45" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" MinHeight="28" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" MinWidth="28" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 말풍선 ───────────────────────────────────────────── -->

    <!-- 왜: 기본 ToolTip 은 노란 바탕 한 줄이라 길면 화면 밖으로 잘린다 — 폭을 두고 테마 색으로 그린다 -->
    <Style TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="10,7">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="FontSize" Value="{StaticResource FontSm}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 단추 ─────────────────────────────────────────────── -->

    <!-- 계약: 기본 단추는 바탕이 없다 — 색을 쓰는 것은 PrimaryButton 하나뿐이라 화면에 강조가 하나만 남는다 -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <!-- 함정: 가로 맞춤을 Center 로 박으면 단추의 HorizontalContentAlignment 가 안 먹는다(필터 단 줄이 가운데로 몰렸다) -->
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 계약: 테두리 없는 보조 단추 — 카드 안의 작은 조작(모두 선택 · 빼기)에 쓴다 -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="{StaticResource FontXs}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 계약: 아이콘만 있는 정사각 단추 — 반드시 ToolTip 을 함께 단다(글자가 없어 뜻이 안 보인다) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 계약: 아이콘 + 글자 단추의 아이콘 — Path 를 이 스타일로 감싸면 단추 글자색을 따라간다 -->
    <Style x:Key="ButtonIcon" TargetType="Path">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ── 창 단추 — 직접 그린 제목 표시줄 ───────────────────── -->

    <!-- 계약: Windows 기본 제목 표시줄을 떼고(WindowChrome) 이 단추 셋으로 대신한다 — 최소화·최대화·닫기 -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 왜: 닫기만 빨갛게 — Windows 와 같은 신호라 설명 없이 읽힌다 -->
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#C50F1F" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionIcon" TargetType="Path" BasedOn="{StaticResource ButtonIcon}">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="StrokeThickness" Value="1.4" />
    </Style>

    <!-- ── 제목 띠 — 테마와 무관하게 짙은 띠 ─────────────────── -->

    <!--
      계약: 제목 띠는 밝은 테마에서도 짙다 — 앱의 얼굴이라 본문 카드와 한눈에 갈려야 한다. 강조색(번짐·밑줄)만 팔레트를 따른다.
      왜: 띠 위의 글자·단추는 테마 브러시를 못 쓴다 — 밝은 테마의 글자색은 짙어서 띠에 묻힌다. 그래서 Title* 브러시를 따로 둔다.
    -->
    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF11131C" Offset="0" />
        <GradientStop Color="#FF1B1E2D" Offset="0.55" />
        <GradientStop Color="#FF141621" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleGlowMask" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#70000000" Offset="0" />
        <GradientStop Color="#1C000000" Offset="0.26" />
        <GradientStop Color="#00000000" Offset="0.55" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleLineMask" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF000000" Offset="0" />
        <GradientStop Color="#66000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
    <!-- 계약: 확인 층(OffBranchLayer · PushGapLayer) 뒤를 가리는 막 — 테마와 무관하게 어둡다 -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#8C0B0D14" />
    <SolidColorBrush x:Key="TitleInkBrush" Color="#FFF4F5FA" />
    <SolidColorBrush x:Key="TitleMutedBrush" Color="#FF9AA1B8" />
    <SolidColorBrush x:Key="TitleHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TitleActiveBrush" Color="#2BFFFFFF" />

    <Style x:Key="TitleCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Foreground" Value="{StaticResource TitleMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TitleHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TitleInkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TitleActiveBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleCloseButton" TargetType="Button" BasedOn="{StaticResource TitleCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#C50F1F" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 계약: 제목 띠의 화면 탭 — 고른 탭은 밝은 판 + 강조색 밑줄. RadioButton 이라 하나만 켜진다 -->
    <!-- 계약: 제목 띠 위의 누르는 단추 — NavTab 과 같은 글자·크기지만 고른 상태가 없다 -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TitleMutedBrush}" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="{StaticResource RadiusSm}" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TitleHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TitleInkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TitleMutedBrush}" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="{StaticResource RadiusSm}" Background="Transparent"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Underline" Height="2" CornerRadius="1" Margin="12,0" VerticalAlignment="Bottom"
                                Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TitleHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TitleInkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource TitleActiveBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TitleInkBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 누르는 카드 · 누르는 줄 · 그룹 머리 ───────────────── -->

    <!-- 계약: 대시보드의 카드 — 누르면 저장소 관리 화면의 그 자리로 건너간다 -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{DynamicResource PanelBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource DividerBrush}" CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 계약: 저장소 목록의 그룹 머리 — 누르면 그 그룹의 줄이 접히고 펴진다(IsChecked = 펴짐) -->
    <Style x:Key="GroupHeader" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="7,6,9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{DynamicResource SubtleOverlayBrush}"
                            CornerRadius="{StaticResource RadiusSm}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Chevron" Data="{StaticResource IconChevronRight}"
                                  Width="10" Height="10" Stretch="Uniform" Margin="2,0,8,0"
                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 켜고 끄는 알약(ToggleButton) ─────────────────────── -->

    <Style x:Key="PillToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontXs}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" CornerRadius="{StaticResource Pill}" BorderThickness="1"
                            BorderBrush="{DynamicResource DividerBrush}" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 글상자 ───────────────────────────────────────────── -->

    <!-- 계약: Tag 에 적은 글이 빈 칸일 때의 흐린 안내 문구가 된다 -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="{StaticResource FontSm}" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextFaintBrush}" />
                        </Trigger>
                        <!-- 왜: 테두리 두께를 바꾸면 안이 1px 움직인다 — 색만 바꾸고 그림자로 초점을 알린다 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 계약: 머리띠의 검색칸 — 왼쪽에 돋보기가 붙는다 -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="32,6,10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Pill}">
                        <Grid>
                            <Path Data="{StaticResource IconSearch}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" />
                            <TextBlock x:Name="Placeholder" IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="{StaticResource FontSm}" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PanelBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 체크 상자 ────────────────────────────────────────── -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5" BorderThickness="1.4"
                                BorderBrush="{DynamicResource TextFaintBrush}" Background="{DynamicResource InputBrush}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Tick" Data="{StaticResource IconCheck}" Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="2.6" Opacity="0"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 고르는 상자 ──────────────────────────────────────── -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}" Margin="3,1" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root" Background="{DynamicResource InputBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSm}" SnapsToDevicePixels="True">
                                        <Path x:Name="Chevron" Data="{StaticResource IconChevronDown}"
                                              Width="11" Height="11" Stretch="Uniform"
                                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Chevron" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- 함정: 오른쪽 여백을 화살표 폭(24)만큼 두지 않으면 고른 글이 화살표 밑으로 들어간다 -->
                        <ContentPresenter x:Name="Selection" IsHitTestVisible="False" Margin="10,5,28,5"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                               Focusable="False" VerticalOffset="4">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="2"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 탭 ───────────────────────────────────────────────── -->

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <!-- 왜: 밑줄을 테두리가 아니라 따로 둔 막대로 그린다 — 둥근 끝과 안쪽 여백을 줄 수 있다 -->
                        <Border x:Name="Underline" Height="2.5" CornerRadius="2" Margin="3,0,3,0"
                                VerticalAlignment="Bottom" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource DividerBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 계약: 탭 묶음 사이의 세로 금이다 — 고를 수 없는 탭이라 누름·키보드 이동이 건너뛴다(설정 창의 공통 탭 | 전용 탭) -->
    <Style x:Key="TabGroupDivider" TargetType="TabItem">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Width="1" Height="16" Margin="10,0" VerticalAlignment="Center"
                            Background="{DynamicResource DividerBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0" />
                        </Border>
                        <!-- 함정: 이 이름이 없으면 고른 탭의 내용이 접근성 트리에 안 올라간다 — 화면 낭독기도 UI 자동화도 못 읽는다 -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 카드 · 칩 · 구분선 ───────────────────────────────── -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 계약: 바탕과 한 겹 띄워야 하는 곳(머리띠·작업 띠)에만 그림자를 준다 — 모든 카드에 주면 화면이 지저분해진다 -->
    <Style x:Key="RaisedCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 계약: 숫자를 담는 작은 알약 — 개수 · 상태처럼 한두 글자만 넣는다 -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource PillSm}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontXs}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- 계약: 일괄 작업 띠의 묶음 하나 — 위에 「번호 + 이름」 한 줄, 아래에 그 묶음의 단추들 -->
    <Style x:Key="ActionGroup" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SubtleOverlayBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="10,6,10,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StepBadge" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <Style x:Key="VDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Margin" Value="8,6" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="HDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <!-- ── 목록 한 줄 ───────────────────────────────────────── -->

    <!-- 계약: diff 바탕은 팔레트를 따르지 않는다 — 더함/지움은 어느 테마에서도 초록/빨강이어야 읽힌다 -->
    <SolidColorBrush x:Key="DiffAddBackBrush" Color="#2434D399" />
    <SolidColorBrush x:Key="DiffDelBackBrush" Color="#24F87171" />

    <Style x:Key="ListRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root" Background="Transparent" CornerRadius="{StaticResource RadiusSm}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <!-- 왜: 어두운 테마에서 AccentSoft 바탕만으로는 고른 줄이 안 보인다 — 왼쪽에 색 막대를 세운다 -->
                        <Border x:Name="Marker" Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,4" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 계약: 조밀 모드에서 쓰는 줄 — 설정 「목록을 조밀하게」가 켜지면 이쪽으로 바꾼다 -->
    <Style x:Key="ListRowCompact" TargetType="ListBoxItem" BasedOn="{StaticResource ListRow}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListRow}" />
    </Style>

    <!-- ── 진행 막대 ────────────────────────────────────────── -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="{StaticResource PillXs}" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Track" Background="Transparent" />
                        <Border x:Name="PART_Indicator" CornerRadius="{StaticResource PillXs}"
                                HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 펼침 ─────────────────────────────────────────────── -->

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Head" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <Path x:Name="Chevron" Data="{StaticResource IconChevronRight}"
                                              Width="9" Height="9" Stretch="Uniform" Margin="0,0,5,0"
                                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="14,4,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 단 나누개 ────────────────────────────────────────── -->

    <!-- 왜: 투명한 나누개는 끌 수 있다는 것이 안 보인다 — 가운데에 흐린 손잡이를 둔다 -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Width="2" CornerRadius="1" VerticalAlignment="Stretch"
                                Margin="0,24" HorizontalAlignment="Center"
                                Background="{DynamicResource DividerBrush}" Opacity="0.7" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Grip" Property="Margin" Value="0,8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 대시보드 통계 카드 ─────────────────────────────────── -->

    <!-- 계약: 카드 머리의 표시 방식 고르개 — 낱말 조각이 한 줄로 붙고 고른 조각만 짙다 -->
    <Style x:Key="KindSwitchItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontXs}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" CornerRadius="{StaticResource RadiusSm}" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KindSwitch" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource KindSwitchItem}" />
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Key" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="{StaticResource RadiusSm}" Padding="2"
                            Background="{DynamicResource SubtleOverlayBrush}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 계약: 대시보드 카드 사이의 나누개 — 「UI 편집」 중(IsEnabled)에만 손잡이가 보이고 끌린다. 평소에는 빈 간격이다 -->
    <Style x:Key="LayoutSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Margin="3" CornerRadius="2" Opacity="0.55"
                                Background="{DynamicResource AccentBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Grip" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
