<UserControl x:Class="GitCenter.App.Views.AddRepoLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Jhj.Core.Wpf.Localization;assembly=Jhj.Core.Wpf"
             xmlns:vm="clr-namespace:GitCenter.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Visibility="{Binding IsAddRepoOpen, Converter={StaticResource BoolToVisibility}}">

    <!--
      「저장소 추가」 층(MainViewModel.AddRepo.cs) - 폴더를 옮겨 다니며 아직 목록에 없는 git 저장소를 골라 더한다.
      계약: 저장소 목록 위의 「저장소 추가」 단추가 연다. 보통 폴더 줄은 두 번 누르거나 ▸ 로 들어간다.
      계약: 폭·높이는 PushGapLayer 와 같은 비율이고 px 는 하한뿐이다 - 목록이 길면 카드 안에서만 스크롤한다.
    -->
    <Grid Background="{StaticResource ScrimBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" MinWidth="620" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8*" MinHeight="420" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Grid.Row="1"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="18,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{loc:Tr '저장소 추가'}" Style="{StaticResource Subtitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,10"
                               Text="{loc:Tr '폴더를 옮겨 다니며 목록에 없는 git 저장소를 골라 더합니다. 폴더 줄은 두 번 누르면 안으로 들어갑니다. 설정만 바뀌고 저장소 파일은 그대로입니다.'}" />

                    <!-- 지금 폴더 줄 - 위로 · 경로 · 이동 · 찾아보기 · 다시 읽기 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="0" Margin="0,0,6,0"
                                Command="{Binding AddRepoUpCommand}" ToolTip="{loc:Tr '위 폴더로'}">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconUp}" Width="12" Height="12" />
                        </Button>
                        <TextBox x:Name="FolderBox" Grid.Column="1" VerticalContentAlignment="Center"
                                 Text="{Binding AddRepoFolder, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding GoAddRepoFolderCommand}"
                                            CommandParameter="{Binding Text, ElementName=FolderBox}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Margin="6,0,0,0" Content="{loc:Tr '이동'}"
                                Command="{Binding GoAddRepoFolderCommand}" CommandParameter="{Binding Text, ElementName=FolderBox}" />
                        <Button Grid.Column="3" Margin="6,0,0,0" Command="{Binding BrowseAddRepoCommand}"
                                ToolTip="{loc:Tr 'Windows 폴더 고르기 창으로 고릅니다'}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFolder}" Width="12" Height="12" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr '찾아보기'}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="0" Margin="6,0,0,0"
                                Command="{Binding ReloadAddRepoCommand}" ToolTip="{loc:Tr '다시 읽기'}">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                        </Button>
                    </Grid>

                    <!-- 계약: 켜 둔 루트 폴더로 바로 가는 단추 - 루트가 없으면 줄째 숨는다 -->
                    <WrapPanel Margin="0,0,0,6" Visibility="{Binding AddRepoRoots.Count, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="{loc:Tr '루트 폴더'}" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,8,4" />
                        <ItemsControl ItemsSource="{Binding AddRepoRoots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" Margin="0,0,4,4" Content="{Binding}"
                                            Command="{Binding DataContext.GoAddRepoFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding AddRepoDeep}" VerticalAlignment="Center"
                                  Content="{loc:Tr '하위 폴더 안의 저장소까지 한 번에 보기 (4단계)'}" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{loc:Tr '모두 체크 · 풀기'}"
                                Command="{Binding ToggleAddRepoAllCommand}" />
                    </Grid>
                </StackPanel>

                <!-- 계약: 단추는 오른쪽에 모은다 - 으뜸 단추는 「추가」(적용 성격이라 PrimaryButton)이고 「닫기」는 보통 단추다 -->
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="{StaticResource FontSm}"
                               Foreground="{DynamicResource WarnBrush}" Text="{Binding AddRepoNote}"
                               Visibility="{Binding AddRepoNote, Converter={StaticResource EmptyToVisibility}}" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyAddRepoCommand}"
                            ToolTip="{loc:Tr '체크한 저장소를 목록에 더합니다 — 숨긴 저장소는 숨김을 풀고, 나머지는 수동 추가에 적습니다'}">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{loc:Tr '추가'}" /><Run Text=" " /><Run Text="{Binding AddRepoCheckedCount, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                    <Button Grid.Column="2" Margin="6,0,0,0" Content="{loc:Tr '닫기'}" Command="{Binding CloseAddRepoCommand}" IsCancel="True" />
                </Grid>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AddRepoItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AddRepoCandidate}">
                                    <Border x:Name="Row" BorderBrush="{DynamicResource SubtleOverlayBrush}" BorderThickness="0,1,0,0"
                                            Padding="4,6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.EnterAddRepoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="Check" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}"
                                                      VerticalAlignment="Center" Visibility="{Binding IsRepo, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- 함정: 아래 트리거가 바꾸는 값(Data · Foreground · Visibility)은 지역 값으로 주면 트리거를 이긴다 - 기본값은 Style 에 둔다 -->
                                            <Path x:Name="Icon" Grid.Column="1" Width="13" Height="13" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource ButtonIcon}">
                                                        <Setter Property="Data" Value="{StaticResource IconBranch}" />
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" />
                                            </StackPanel>
                                            <TextBlock x:Name="State" Grid.Column="3" Text="{Binding StateText}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" FontSize="{StaticResource FontSm}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button x:Name="Enter" Grid.Column="4" Width="24" Height="24" MinHeight="0"
                                                    HorizontalAlignment="Right" ToolTip="{loc:Tr '이 폴더로 들어가기'}"
                                                    Command="{Binding DataContext.EnterAddRepoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Style>
                                                </Button.Style>
                                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconChevronRight}" Width="9" Height="9" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="repo">
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource OkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="hidden">
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="listed">
                                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="folder">
                                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconFolder}" />
                                            <Setter TargetName="Enter" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="empty">
                                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconFolder}" />
                                            <Setter TargetName="Enter" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                        </DataTrigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{loc:Tr '폴더를 읽는 중…'}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding AddRepoLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
