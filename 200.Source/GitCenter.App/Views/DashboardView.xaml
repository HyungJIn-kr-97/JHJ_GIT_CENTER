<UserControl x:Class="GitCenter.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Jhj.Core.Wpf.Localization;assembly=Jhj.Core.Wpf"
             xmlns:vm="clr-namespace:GitCenter.App.ViewModels"
             xmlns:controls="clr-namespace:GitCenter.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <!--
      대시보드 화면 — 현황 칸 한 줄 + 카드 세 줄(통계 여덟 · 목록 셋).
      계약: 페이지 스크롤이 없다 — 세 줄이 남는 높이를 나눠 갖고 카드 안에서만 굴린다.
      계약: 줄·칸의 비율은 별(*) 무게다 — 「UI 편집」 중에만 나누개로 바꾸고 「저장」이 Settings.DashboardLayout 에 적는다(DashboardView.xaml.cs).
      계약: 격자 넷의 x:Name(LayoutRows · TopRow · MiddleRow · BottomRow)이 저장 열쇠와 짝이다 — 짝수 자리가 카드, 홀수 자리가 나누개다.
      계약: 통계 카드의 그림은 Controls/ChartView 가 그린다 — 표시 방식은 카드 머리의 고르개가 바꾸고 고르는 즉시 저장된다.
    -->
    <UserControl.Resources>
        <!-- 통계 카드 하나의 속 — 제목 · 표시 방식 고르개 · 그림 -->
        <DataTemplate x:Key="ChartCardBody" DataType="{x:Type vm:ChartCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0"
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.IsDashboardEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Title" SelectedItem="{Binding Pick, Mode=TwoWay}"
                              MinWidth="150" MaxDropDownHeight="360" VerticalAlignment="Center"
                              ToolTip="{loc:Tr '이 칸에 올릴 통계를 고릅니다 — 이미 다른 칸에 있으면 두 칸이 자리를 바꿉니다'}"
                              Visibility="{Binding DataContext.IsDashboardEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Caption}" Style="{StaticResource Micro}" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ListBox Grid.Column="2" Margin="8,0,0,0"
                             ItemsSource="{Binding Metrics}" SelectedValue="{Binding Metric, Mode=TwoWay}"
                             ToolTip="{loc:Tr '지표 — 무엇을 셀지'}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource KindSwitch}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Metrics.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                    <!-- 계약: 기간 고르개는 UsesRange 가 숨긴다 — 기간이 없는 카드뿐 아니라 기간이 뜻 없는 지표에서도 -->
                    <ListBox Grid.Column="3" Margin="8,0,0,0"
                             ItemsSource="{Binding Ranges}" SelectedValue="{Binding Range, Mode=TwoWay}"
                             ToolTip="{loc:Tr '기간'}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource KindSwitch}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsesRange}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                    <ListBox Grid.Column="4" Style="{StaticResource KindSwitch}" Margin="8,0,0,0"
                             ItemsSource="{Binding Kinds}" SelectedValue="{Binding Kind, Mode=TwoWay}"
                             ToolTip="{loc:Tr '표시 방식'}" />
                </Grid>
                <controls:ChartView Grid.Row="1" Data="{Binding Data}" Kind="{Binding Kind}" RowCommand="{Binding RowCommand}"
                                    Ink="{DynamicResource TextPrimaryBrush}"
                                    Muted="{DynamicResource TextMutedBrush}"
                                    Track="{DynamicResource SubtleOverlayBrush}"
                                    Surface="{DynamicResource PanelBrush}"
                                    Accent="{DynamicResource AccentBrush}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ChartCard" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource ChartCardBody}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 머리 — 화면 이름 · 상태를 읽은 때 · UI 편집 · 새로 고침 -->
        <Grid Grid.Row="0" Margin="4,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr '대시보드'}" Style="{StaticResource Title}" />
                <TextBlock Text="{Binding LastStatusText}" Style="{StaticResource Caption}" Margin="12,0,0,2"
                           VerticalAlignment="Bottom" />
                <Border Style="{StaticResource Chip}" Margin="12,0,0,0" Padding="9,2" VerticalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding IsDashboardEditing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Tr 'UI 편집 중 · 카드 사이 손잡이로 크기 조절 · 카드 제목에서 통계 고르기'}" Style="{StaticResource ChipText}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 편집 중 — 기본 배치 · 취소 · 저장 -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsDashboardEditing, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource GhostButton}" Click="OnResetLayoutClick"
                            ToolTip="{loc:Tr '처음 배치 비율로 되돌립니다 — 저장을 눌러야 남습니다'}">
                        <TextBlock Text="{loc:Tr '기본 배치'}" FontSize="{StaticResource FontXs}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="OnCancelLayoutClick" Margin="4,0,0,0">
                        <TextBlock Text="{loc:Tr '취소'}" FontSize="{StaticResource FontXs}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="OnSaveLayoutClick" Margin="6,0,0,0">
                        <TextBlock Text="{loc:Tr '배치 저장'}" FontSize="{StaticResource FontXs}" />
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Click="OnEditLayoutClick"
                        ToolTip="{loc:Tr '카드 크기를 조절하고 그 배치를 저장합니다'}"
                        Visibility="{Binding IsDashboardEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconGrid}"
                              Width="13" Height="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Tr 'UI 편집'}" FontSize="{StaticResource FontXs}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource VDivider}" Height="20" Margin="7,0" />
                <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshStatusCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconRefresh}"
                              Width="13" Height="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Tr '상태 새로 고침'}" FontSize="{StaticResource FontXs}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding RescanCommand}" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconScan}"
                              Width="13" Height="13" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Tr '목록 새로 고침'}" FontSize="{StaticResource FontXs}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource VDivider}" Height="20" Margin="7,0" />
                <Button Style="{StaticResource IconButton}" Click="OnSettingsClick" ToolTip="{loc:Tr '설정'}">
                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconGear}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 현황 카드 — 누르면 그 상태로 걸러 저장소 관리로 간다 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stats}" Margin="0,0,-10,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource CardButton}" Margin="0,0,10,0"
                            Command="{Binding DataContext.GoToStateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="{loc:Tr '이 상태의 저장소 보기'}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                         Fill="{Binding Tone, Converter={StaticResource StateBrush}}"
                                         Visibility="{Binding ShowDot, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontHero}" FontWeight="Bold"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 카드 세 줄 — 줄 사이·칸 사이의 10px 이 나누개 자리다 -->
        <Grid x:Name="LayoutRows" Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <GridSplitter Grid.Row="1" Style="{StaticResource LayoutSplitter}" ResizeDirection="Rows" Cursor="SizeNS"
                          IsEnabled="{Binding IsDashboardEditing}" />
            <GridSplitter Grid.Row="3" Style="{StaticResource LayoutSplitter}" ResizeDirection="Rows" Cursor="SizeNS"
                          IsEnabled="{Binding IsDashboardEditing}" />

            <!-- 첫 줄 — 그룹별 현황 + 통계 칸 셋(Slots[0..2] · 처음 배치: 대표 상태 분포 · 변경 파일 구성 · 소스 확장자 구성) -->
            <Grid x:Name="TopRow" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                </Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="1" Style="{StaticResource LayoutSplitter}" ResizeDirection="Columns" Cursor="SizeWE"
                              IsEnabled="{Binding IsDashboardEditing}" />
                <GridSplitter Grid.Column="5" Style="{StaticResource LayoutSplitter}" ResizeDirection="Columns" Cursor="SizeWE"
                              IsEnabled="{Binding IsDashboardEditing}" />
                <GridSplitter Grid.Column="3" Style="{StaticResource LayoutSplitter}" ResizeDirection="Columns" Cursor="SizeWE"
                              IsEnabled="{Binding IsDashboardEditing}" />

                <!-- 그룹별 현황 — 「카드」는 건너가는 단추, 나머지 방식은 ChartView 가 그린다 -->
                <!-- 계약: 둘째 줄의 지표 고르개(무엇을 셀까)와 기간은 GroupChart.Metric · Range 다 — 카드·그림 모두 같은 수를 본다 -->
                <Border Style="{StaticResource Card}" Padding="14,12,8,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr '그룹별 현황'}" Style="{StaticResource SectionTitle}" Margin="0"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Groups.Count}" Style="{StaticResource ChipText}" />
                            </Border>
                            <ListBox Grid.Column="2" Style="{StaticResource KindSwitch}"
                                     ItemsSource="{Binding GroupChart.Kinds}"
                                     SelectedValue="{Binding GroupChart.Kind, Mode=TwoWay}"
                                     ToolTip="{loc:Tr '표시 방식'}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding GroupChart.Metrics}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding GroupChart.Metric, Mode=TwoWay}"
                                      MinWidth="110" VerticalAlignment="Center"
                                      ToolTip="{loc:Tr '지표 — 그룹마다 무엇을 셀지 고릅니다'}" />
                            <ListBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                     ItemsSource="{Binding GroupChart.Ranges}" SelectedValue="{Binding GroupChart.Range, Mode=TwoWay}"
                                     ToolTip="{loc:Tr '기간'}">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource KindSwitch}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GroupChart.UsesRange}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                            </ListBox>
                            <TextBlock Grid.Column="2" Text="{Binding GroupChart.Caption}" Style="{StaticResource Micro}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <controls:ChartView Grid.Row="2" Margin="0,0,6,2"
                                            Data="{Binding GroupChart.Data}" Kind="{Binding GroupChart.Kind}"
                                            Ink="{DynamicResource TextPrimaryBrush}"
                                            Muted="{DynamicResource TextMutedBrush}"
                                            Track="{DynamicResource SubtleOverlayBrush}"
                                            Surface="{DynamicResource PanelBrush}"
                                            Accent="{DynamicResource AccentBrush}">
                            <controls:ChartView.Style>
                                <Style TargetType="controls:ChartView">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GroupChart.Kind}" Value="cards">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:ChartView.Style>
                        </controls:ChartView>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GroupChart.Kind}" Value="cards">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding GroupCards}" Margin="0,0,-2,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- 왜: 칸 폭이 편집으로 바뀐다 — 고정 3열 대신 폭에 맞춰 줄을 바꾼다 -->
                                        <WrapPanel VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButton}" Margin="0,0,8,8" Padding="12,10" Width="196"
                                                Command="{Binding DataContext.GoToGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:Tr '이 그룹의 저장소 보기'}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Data="{StaticResource IconFolder}" Width="13" Height="13"
                                                          Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                                          StrokeLineJoin="Round" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="6,1"
                                                            Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Total}" Style="{StaticResource ChipText}" />
                                                    </Border>
                                                </Grid>
                                                <!-- 「상태」 지표 — 계약: 막대는 「깨끗한 저장소 / 전체」다 -->
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.GroupChart.Metric, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="state">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ProgressBar Margin="0,9,0,0" Minimum="0" Maximum="{Binding Total}"
                                                                 Value="{Binding Clean, Mode=OneWay}"
                                                                 Foreground="{DynamicResource OkBrush}" />
                                                    <WrapPanel Margin="0,7,0,0">
                                                        <TextBlock Style="{StaticResource Micro}" Margin="0,0,8,0">
                                                            <Run Text="깨끗함 " /><Run Text="{Binding Clean, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource Micro}" Margin="0,0,8,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DirtyBrush}"
                                                                   Visibility="{Binding Dirty, Converter={StaticResource CountToVisibility}}">
                                                            <Run Text="변경 " /><Run Text="{Binding Dirty, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource Micro}" Margin="0,0,8,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AheadBrush}"
                                                                   Visibility="{Binding Ahead, Converter={StaticResource CountToVisibility}}">
                                                            <Run Text="올릴 것 " /><Run Text="{Binding Ahead, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource Micro}" Margin="0,0,8,0" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BehindBrush}"
                                                                   Visibility="{Binding Behind, Converter={StaticResource CountToVisibility}}">
                                                            <Run Text="받을 것 " /><Run Text="{Binding Behind, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource Micro}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DangerBrush}"
                                                                   Visibility="{Binding Problem, Converter={StaticResource CountToVisibility}}">
                                                            <Run Text="문제 " /><Run Text="{Binding Problem, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <!-- 그 밖의 지표 — 계약: 막대는 「이 그룹 / 가장 큰 그룹」이고 글은 MainViewModel.RefreshGroupChart 가 만든다 -->
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.GroupChart.Metric, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="state">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ProgressBar Margin="0,9,0,0" Minimum="0" Maximum="{Binding MetricMax}"
                                                                 Value="{Binding MetricValue, Mode=OneWay}"
                                                                 Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="{Binding MetricText}" />
                                                    <TextBlock Style="{StaticResource Micro}" Margin="0,2,0,0" Text="{Binding MetricNote}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding MetricNote.Length, Converter={StaticResource CountToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <ContentControl Grid.Column="2" Style="{StaticResource ChartCard}" Content="{Binding Slots[0]}" />
                <ContentControl Grid.Column="4" Style="{StaticResource ChartCard}" Content="{Binding Slots[1]}" />
                <ContentControl Grid.Column="6" Style="{StaticResource ChartCard}" Content="{Binding Slots[2]}" />
            </Grid>

            <!-- 가운데 줄 — 커밋 캘린더 · 변경 많은 저장소 · 변경 줄 수 · 마지막 커밋 시점 -->
            <Grid x:Name="MiddleRow" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                </Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="1" Style="{StaticResource LayoutSplitter}" ResizeDirection="Columns" Cursor="SizeWE"
                              IsEnabled="{Binding IsDashboardEditing}" />
                <GridSplitter Grid.Column="5" Style="{StaticResource LayoutSplitter}" ResizeDirection="Columns" Cursor="SizeWE"
                              IsEnabled="{Binding IsDashboardEditing}" />
                <GridSplitter Grid.Column="3" Style="{StaticResource LayoutSplitter}" ResizeDirection="Columns" Cursor="SizeWE"
                              IsEnabled="{Binding IsDashboardEditing}" />

                <ContentControl Grid.Column="0" Style="{StaticResource ChartCard}" Content="{Binding Slots[3]}" />
                <ContentControl Grid.Column="2" Style="{StaticResource ChartCard}" Content="{Binding Slots[4]}" />
                <ContentControl Grid.Column="4" Style="{StaticResource ChartCard}" Content="{Binding Slots[5]}" />
                <ContentControl Grid.Column="6" Style="{StaticResource ChartCard}" Content="{Binding Slots[6]}" />
            </Grid>

            <!-- 아래 줄 — 확인 필요 · 최근 커밋 · 최근 작업 -->
            <Grid x:Name="BottomRow" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                </Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="1" Style="{StaticResource LayoutSplitter}" ResizeDirection="Columns" Cursor="SizeWE"
                              IsEnabled="{Binding IsDashboardEditing}" />
                <GridSplitter Grid.Column="3" Style="{StaticResource LayoutSplitter}" ResizeDirection="Columns" Cursor="SizeWE"
                              IsEnabled="{Binding IsDashboardEditing}" />

                <Border Style="{StaticResource Card}" Padding="12,12,6,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                            <TextBlock Text="{loc:Tr '확인 필요 저장소'}" Style="{StaticResource SectionTitle}" Margin="0"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1"
                                    Visibility="{Binding Attention.Count, Converter={StaticResource CountToVisibility}}">
                                <TextBlock Text="{Binding Attention.Count}" Style="{StaticResource ChipText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{loc:Tr '확인할 저장소가 없습니다.'}" Style="{StaticResource Caption}"
                                   Margin="2,6,0,0"
                                   Visibility="{Binding Attention.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Attention}" Margin="0,0,4,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.GoToRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource Micro}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding BranchText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ChangeText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="7,1" Margin="8,0,0,0"
                                                        Background="{DynamicResource SubtleOverlayBrush}">
                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource ChipText}"
                                                               Foreground="{Binding StateText, Converter={StaticResource StateBrush}}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,12,6,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Tr '최근 커밋'}" Style="{StaticResource SectionTitle}" Margin="2,0,0,6" />
                        <TextBlock Grid.Row="1" Text="{loc:Tr '읽은 커밋이 없습니다.'}" Style="{StaticResource Caption}"
                                   Margin="2,6,0,0"
                                   Visibility="{Binding RecentCommits.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentCommits}" Margin="0,0,4,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowButton}"
                                                Command="{Binding DataContext.OpenRepoHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding BranchText}" Style="{StaticResource Mono}"
                                                               FontSize="{StaticResource FontXs}" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastCommitLine}" Style="{StaticResource Micro}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12,12,6,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 계약: 여기는 git 기록(RecentWork)이다 — 앱이 한 일(Activity)은 「시스템 작업 로그」 탭이 보인다 -->
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                            <TextBlock Text="{loc:Tr '최근 작업'}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecentWorkCaption}" Style="{StaticResource Micro}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{loc:Tr '작업이 없습니다.'}" Style="{StaticResource Caption}"
                                   Margin="2,6,0,0"
                                   Visibility="{Binding RecentWork.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding RecentWork}" Padding="0,0,4,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Micro}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       FontSize="{StaticResource FontSm}"
                                                       Foreground="{Binding Outcome, Converter={StaticResource OutcomeBrush}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   FontSize="{StaticResource FontSm}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
