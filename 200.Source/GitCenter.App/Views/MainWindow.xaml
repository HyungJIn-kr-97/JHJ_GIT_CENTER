<Window x:Class="GitCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GitCenter.App.Localization"
        xmlns:vm="clr-namespace:GitCenter.App.ViewModels"
        Title="Git 통합 관리 센터"
        Width="1480" Height="900" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ① 머리띠 — 제목 · 검색 · 목록 단추 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr 'Git 통합 관리 센터'}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Caption}"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0">
                <TextBlock Text="{loc:Tr '검색'}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="0,0,7,0" />
                <TextBox Width="260" MaxWidth="360" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="이름·묶음·경로로 거릅니다" />
                <CheckBox Content="{loc:Tr '변경된 것만'}" Margin="10,0,0,0"
                          IsChecked="{Binding ChangedOnly}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{loc:Tr '목록 새로 고침'}" Command="{Binding RescanCommand}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr '상태 새로 고침'}" Command="{Binding RefreshStatusCommand}" Margin="0,0,6,0" />
                <Button x:Name="SettingsButton" Content="{loc:Tr '설정'}" Click="OnSettingsClick" />
            </StackPanel>
        </Grid>

        <!-- ② 알림 줄 — git 없음 · 출처 경고 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,0,6"
                    Visibility="{Binding IsGitMissing, Converter={StaticResource BoolToVisibility}}"
                    BorderBrush="{DynamicResource DangerBrush}">
                <TextBlock Text="{Binding GitVersionText}" Foreground="{DynamicResource DangerBrush}" />
            </Border>
            <Border Style="{StaticResource Card}" Padding="10,7"
                    Visibility="{Binding SourceNotes, Converter={StaticResource EmptyToVisibility}}">
                <TextBlock Text="{Binding SourceNotes}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ③ 3단 — 저장소 · 상세 · 작업 로그 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*" MinWidth="330" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="42*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="28*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 좌: 저장소 목록 -->
            <Border Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr '저장소'}" Style="{StaticResource SectionTitle}" Margin="0" />
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                            <Run Text="개 선택" />
                        </TextBlock>
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="{loc:Tr '모두 선택'}" Command="{Binding SelectAllCommand}" Padding="8,4" Margin="0,0,5,5" />
                        <Button Content="{loc:Tr '선택 해제'}" Command="{Binding SelectNoneCommand}" Padding="8,4" Margin="0,0,5,5" />
                        <Button Content="변경된 것만 선택" Command="{Binding SelectChangedCommand}" Padding="8,4" Margin="0,0,5,5" />
                        <Button Content="{loc:Tr '목록에서 숨기기'}" Command="{Binding HideSelectedCommand}" Padding="8,4" Margin="0,0,0,5" />
                    </WrapPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                             ItemContainerStyle="{StaticResource ListRow}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepoRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,8,0" />

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                                     Fill="{Binding StateText, Converter={StaticResource StateBrush}}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Group}" Style="{StaticResource Caption}" Margin="8,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="15,2,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding BranchText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding AheadBehindText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ChangeText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" Margin="15,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding LastOutcome, Converter={StaticResource OutcomeBrush}}"
                                                   Text="{Binding LastResult}"
                                                   Visibility="{Binding LastResult, Converter={StaticResource EmptyToVisibility}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="…" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 중: 고른 저장소의 상세 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:Tr '저장소를 고르면 상태가 여기에 보입니다.'}"
                               Style="{StaticResource Caption}"
                               Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />

                    <StackPanel Grid.Row="0" DataContext="{Binding SelectedRow}"
                                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding StateText, Converter={StaticResource StateBrush}}" />
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BranchText}" Margin="12,2,0,0"
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AheadBehindText}" Style="{StaticResource Caption}" Margin="10,3,0,0" />
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" Margin="10,3,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" Margin="18,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LastCommitText}" Style="{StaticResource Caption}" Margin="18,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,6"
                               IsEnabled="{Binding SelectedRow, Converter={StaticResource NullToBool}}">
                        <Button Content="{loc:Tr '폴더에서 열기'}" Command="{Binding OpenFolderCommand}" Padding="9,4" Margin="0,0,5,5" />
                        <Button Content="{loc:Tr '터미널에서 열기'}" Command="{Binding OpenTerminalCommand}" Padding="9,4" Margin="0,0,5,5" />
                        <Button Content="{loc:Tr 'GitHub Desktop 에서 열기'}" Command="{Binding OpenDesktopCommand}" Padding="9,4" Margin="0,0,5,5" />
                        <Button Content="{loc:Tr 'VS Code 에서 열기'}" Command="{Binding OpenCodeCommand}" Padding="9,4" Margin="0,0,5,5" />
                        <Button Content="{loc:Tr '원격 페이지 열기'}" Command="{Binding OpenRemoteCommand}" Padding="9,4" Margin="0,0,0,5" />
                    </WrapPanel>

                    <TabControl Grid.Row="2" SelectedIndex="{Binding DetailTabIndex}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr '변경 파일'}" />
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Margin="6,0,0,0"
                                            Padding="6,1" Visibility="{Binding Changes.Count, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding Changes.Count}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <TextBlock Text="{loc:Tr '변경이 없습니다.'}" Style="{StaticResource Caption}" Margin="4,10,0,0"
                                           Visibility="{Binding Changes.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                <ListBox ItemsSource="{Binding Changes}" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource ListRow}" Margin="0,6,0,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Converter={StaticResource ChangeKind}}"
                                                           Style="{StaticResource Caption}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" Style="{StaticResource Mono}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{loc:Tr '브랜치'}">
                            <ListBox ItemsSource="{Binding Branches}" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ListRow}" Margin="0,6,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="●" Margin="0,0,6,0" FontSize="9" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" />
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="{Binding Upstream, Mode=OneWay, TargetNullValue='추적 없음'}" />
                                                    <Run Text=" · 앞섬 " /><Run Text="{Binding Ahead, Mode=OneWay}" />
                                                    <Run Text=" · 뒤처짐 " /><Run Text="{Binding Behind, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                       Text="{Binding LastCommitWhen, StringFormat={}{0:yyyy-MM-dd}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr '충돌'}" />
                                    <Border Background="{DynamicResource DangerBrush}" CornerRadius="9" Margin="6,0,0,0"
                                            Padding="6,1" Visibility="{Binding Conflicts.Count, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding Conflicts.Count}" FontSize="11" Foreground="{DynamicResource PanelBrush}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <TextBlock Text="{loc:Tr '충돌이 없습니다.'}" Style="{StaticResource Caption}" Margin="4,10,0,0"
                                           Visibility="{Binding Conflicts.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding Conflicts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                                   Visibility="{Binding Note, Converter={StaticResource EmptyToVisibility}}" />
                                                        <ItemsControl ItemsSource="{Binding Hunks}" Margin="0,6,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,0,0,10">
                                                                        <TextBlock Style="{StaticResource Caption}">
                                                                            <Run Text="{Binding StartLine, Mode=OneWay}" /><Run Text="줄" />
                                                                        </TextBlock>
                                                                        <Border BorderThickness="3,0,0,0" Padding="8,4" Margin="0,4,0,0"
                                                                                BorderBrush="{DynamicResource AheadBrush}"
                                                                                Background="{DynamicResource SubtleOverlayBrush}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding OursLabel}" Style="{StaticResource Caption}"
                                                                                           Foreground="{DynamicResource AheadBrush}" />
                                                                                <TextBlock Text="{Binding Ours, Converter={StaticResource Lines}}"
                                                                                           Style="{StaticResource Mono}" TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border BorderThickness="3,0,0,0" Padding="8,4" Margin="0,3,0,0"
                                                                                BorderBrush="{DynamicResource BehindBrush}"
                                                                                Background="{DynamicResource SubtleOverlayBrush}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding TheirsLabel}" Style="{StaticResource Caption}"
                                                                                           Foreground="{DynamicResource BehindBrush}" />
                                                                                <TextBlock Text="{Binding Theirs, Converter={StaticResource Lines}}"
                                                                                           Style="{StaticResource Mono}" TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 우: 작업 로그 -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{loc:Tr '작업 로그'}" Style="{StaticResource SectionTitle}" />

                    <Grid Grid.Row="1">
                        <TextBlock Text="{loc:Tr '작업이 없습니다.'}" Style="{StaticResource Caption}" Margin="4,6,0,0"
                                   Visibility="{Binding Activity.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                        <ListBox ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ListRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       Foreground="{Binding Outcome, Converter={StaticResource OutcomeBrush}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="12" />
                                        <Expander Margin="0,3,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                                            <Expander.Header>
                                                <TextBlock Text="자세히" Style="{StaticResource Caption}" />
                                            </Expander.Header>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ④ 일괄 작업 띠 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">
                    <Button Content="{loc:Tr '전체 Fetch'}" Command="{Binding FetchCommand}" Margin="0,0,6,6"
                            ToolTip="원격만 읽습니다 — 작업 트리를 건드리지 않습니다" />
                    <Button Content="{loc:Tr 'main 받기'}" Command="{Binding UpdateDefaultCommand}" Margin="0,0,6,6"
                            ToolTip="체크아웃을 바꾸지 않고 기본 브랜치만 빨리감기로 갱신합니다" />
                    <Button Content="{loc:Tr '현재로 병합'}" Command="{Binding MergeDefaultCommand}" Margin="0,0,6,6"
                            ToolTip="origin/기본브랜치를 지금 브랜치로 병합합니다 — 충돌하면 멈추고 알려 줍니다" />
                    <Button Content="{loc:Tr '현재 브랜치 Pull'}" Command="{Binding PullCurrentCommand}" Margin="0,0,6,6" />
                    <Button Content="{loc:Tr '모든 추적 브랜치 갱신'}" Command="{Binding UpdateAllBranchesCommand}" Margin="0,0,18,6" />

                    <Button Content="{loc:Tr '커밋'}" Command="{Binding CommitCommand}" Margin="0,0,6,6" />
                    <Button Content="{loc:Tr '올리기(Push)'}" Command="{Binding PushCommand}" Margin="0,0,6,6" />
                    <Button Content="{loc:Tr '커밋 + 올리기'}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CommitAndPushCommand}" Margin="0,0,18,6" />

                    <Button Content="{loc:Tr '병합 되돌리기'}" Command="{Binding AbortCommand}" Margin="0,0,6,6"
                            ToolTip="진행 중인 병합·리베이스를 취소합니다" />
                </WrapPanel>

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{loc:Tr '커밋 메시지'}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="{loc:Tr '멈추기'}" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                            IsEnabled="{Binding IsBusy}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ⑤ 진행 띠 -->
        <Grid Grid.Row="4" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Height="6" Margin="10,0" VerticalAlignment="Center"
                         Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone}"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}"
                         BorderThickness="0"
                         Visibility="{Binding ProgressTotal, Converter={StaticResource CountToVisibility}}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Visibility="{Binding ProgressTotal, Converter={StaticResource CountToVisibility}}">
                <Run Text="{Binding ProgressDone, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding ProgressTotal, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </Grid>
</Window>
