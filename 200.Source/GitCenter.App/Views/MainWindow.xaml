<Window x:Class="GitCenter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Jhj.Core.Wpf.Localization;assembly=Jhj.Core.Wpf"
        xmlns:core="clr-namespace:Jhj.Core.App;assembly=Jhj.Core"
        xmlns:vm="clr-namespace:GitCenter.App.ViewModels"
        xmlns:views="clr-namespace:GitCenter.App.Views"
        xmlns:controls="clr-namespace:GitCenter.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JHJ Git Center"
        MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <!--
      계약: Windows 제목 표시줄을 떼고 머리띠가 그 일을 한다 — 끌기·두 번 눌러 최대화·단추 셋.
      왜: WindowStyle="None" 대신 WindowChrome 을 쓴다 — 스냅(Win+방향키)·가장자리 크기 조절·그림자가 그대로 산다.
      함정: CaptionHeight 를 0 으로 두어 캡션을 통째로 client 로 돌린다 — 끌기는 코드가 직접 한다.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 계약: 「작업 로그」와 「시스템 작업 로그」 두 탭이 같은 줄 모양을 쓴다 — 한 곳에서만 고친다 -->
        <DataTemplate x:Key="ActivityRow" DataType="{x:Type vm:ActivityEntry}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Micro}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" Margin="8,0,0,0"
                               FontSize="{StaticResource FontSm}"
                               Foreground="{Binding Outcome, Converter={StaticResource OutcomeBrush}}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0"
                           FontSize="{StaticResource FontSm}" />
                <Expander Margin="0,4,0,0"
                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                    <Expander.Header>
                        <TextBlock Text="{loc:Tr '자세히'}" Style="{StaticResource Micro}" />
                    </Expander.Header>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Expander>
            </StackPanel>
        </DataTemplate>

        <!-- 계약: 분류 알약 하나 — Tag 가 건수다. 로그 탭의 아래 줄만 쓴다 -->
        <Style x:Key="LogKindToggle" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontXs}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            <TextBlock Margin="5,0,0,0" FontSize="{StaticResource FontXs}" FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                       Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          로그 탭의 몸통 — 목록 + 아래의 분류·검색 줄. 세 탭(작업 로그 · 시스템 작업 로그 · 시스템 오류)이 함께 쓴다.
          계약: 분류·검색은 탭마다 따로다(ActivityLogView) — 「기록 없음」 문구는 탭이 제각각 얹는다.
        -->
        <DataTemplate x:Key="ActivityLogPane" DataType="{x:Type vm:ActivityLogView}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Caption}" Margin="4,8,8,0" TextWrapping="Wrap"
                           Text="{loc:Tr '조건에 맞는 기록이 없습니다 — 분류나 검색어를 바꿔 보십시오.'}"
                           Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ListBox ItemsSource="{Binding Items}" Padding="0,0,4,0"
                         ItemTemplate="{StaticResource ActivityRow}" />

                <StackPanel Grid.Row="1" Margin="0,8,8,0"
                            Visibility="{Binding TotalCount, Converter={StaticResource CountToVisibility}}">
                    <WrapPanel>
                        <ToggleButton Style="{StaticResource LogKindToggle}" Content="{loc:Tr '전체'}"
                                      Tag="{Binding TotalCount}" IsChecked="{Binding IsAll, Mode=TwoWay}" />
                        <ToggleButton Style="{StaticResource LogKindToggle}" Content="{loc:Tr '성공'}"
                                      Tag="{Binding OkCount}" IsChecked="{Binding IsOk, Mode=TwoWay}"
                                      Visibility="{Binding ErrorsOnly, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <ToggleButton Style="{StaticResource LogKindToggle}" Content="{loc:Tr '실패'}"
                                      Tag="{Binding FailedCount}" IsChecked="{Binding IsFailed, Mode=TwoWay}" />
                        <ToggleButton Style="{StaticResource LogKindToggle}" Content="{loc:Tr '충돌'}"
                                      Tag="{Binding ConflictCount}" IsChecked="{Binding IsConflict, Mode=TwoWay}" />
                        <ToggleButton Style="{StaticResource LogKindToggle}" Content="{loc:Tr '건너뜀'}"
                                      Tag="{Binding SkippedCount}" IsChecked="{Binding IsSkipped, Mode=TwoWay}"
                                      Visibility="{Binding ErrorsOnly, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    </WrapPanel>
                    <TextBox Style="{StaticResource SearchBox}" Margin="0,2,0,0"
                             Tag="{loc:Tr '저장소 · 내용 · 시각으로 검색'}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- 계약: 창 전체 배율은 이 하나로 건다 — 설정 「화면 배율」이 ShellScale 을 바꾼다(MainWindow.xaml.cs) -->
    <!-- 계약: F5 는 「상태 새로 고침」, Shift+F5 는 「목록 새로 고침」이다 — 창 안에서만 먹는다(전역 단축키가 아니다) -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshStatusCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding RescanCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Shell" Margin="0">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          ① 제목 띠 — 상표 · 화면 탭 · 창 단추. 끌기·두 번 눌러 최대화가 여기서 일어난다.
          계약: 띠는 테마와 무관하게 짙다(Styles.xaml 「제목 띠」) — 본문과 한눈에 갈린다.
          왜: 앱 단추(새로 고침·설정)는 여기 두지 않는다 — 창 단추와 성격이 달라 각 화면의 도구줄이 갖는다.
        -->
        <Border Grid.Row="0" Height="48" Background="{StaticResource TitleBarBrush}"
                MouseLeftButtonDown="OnCaptionMouseDown" MouseRightButtonUp="OnCaptionRightClick">
            <Grid>
                <Rectangle Fill="{DynamicResource AccentBrush}" OpacityMask="{StaticResource TitleGlowMask}"
                           IsHitTestVisible="False" />
                <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}"
                           OpacityMask="{StaticResource TitleLineMask}" IsHitTestVisible="False" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                IsHitTestVisible="False">
                        <!-- 계약: 창 머리 그림은 앱 아이콘 그 자체다(AppIcon.Bind) · 제목은 「JHJ <앱 이름>」 — 080.CS앱-화면-공통.md §1·§2 -->
                        <Image x:Name="TitleIcon" Width="30" Height="30" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="JHJ Git Center" FontSize="{StaticResource FontMd}"
                                       FontWeight="Bold" Foreground="{StaticResource TitleInkBrush}" />
                            <TextBlock Text="{loc:Tr 'Git 통합 관리 센터'}" FontSize="9" FontWeight="SemiBold" Margin="0,1,0,0"
                                       Foreground="{StaticResource TitleMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 화면 탭 — 0 대시보드 · 1 저장소 관리 -->
                    <StackPanel x:Name="NavTabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                        <RadioButton Style="{StaticResource NavTab}" GroupName="MainNav"
                                     IsChecked="{Binding PageIndex, Converter={StaticResource IndexToBool}, ConverterParameter=0}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconGrid}"
                                      Width="13" Height="13" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Tr '대시보드'}" FontSize="{StaticResource FontSm}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTab}" GroupName="MainNav"
                                     IsChecked="{Binding PageIndex, Converter={StaticResource IndexToBool}, ConverterParameter=1}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconList}"
                                      Width="13" Height="13" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Tr '저장소 관리'}" FontSize="{StaticResource FontSm}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTab}" GroupName="MainNav"
                                     IsChecked="{Binding PageIndex, Converter={StaticResource IndexToBool}, ConverterParameter=2}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconBranch}"
                                      Width="13" Height="13" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Tr '커밋 내역'}" FontSize="{StaticResource FontSm}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavTab}" GroupName="MainNav"
                                     IsChecked="{Binding PageIndex, Converter={StaticResource IndexToBool}, ConverterParameter=3}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCheck}"
                                      Width="13" Height="13" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Tr '점검'}" FontSize="{StaticResource FontSm}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- 왜: 도움말은 어느 화면에서든 그 화면을 짚는다 — 화면 도구줄이 아니라 탭 옆(창 단추와는 떨어진 자리)에 둔다 -->
                    <Button x:Name="HelpButton" Grid.Column="2" Style="{StaticResource NavButton}" HorizontalAlignment="Left"
                            Content="{loc:Tr '도움말'}" ToolTip="{loc:Tr '이 화면의 기능을 차례로 짚어 줍니다'}"
                            Click="OnHelpClick" />

                    <!-- 계약: GitHub 계정 칩 — gh CLI 의 로그인(Services/GitHubAccount). 누르면 로그인 콘솔을 열거나 로그아웃한다. 창 단추와는 띄워 둔다 -->
                    <Button x:Name="AccountButton" Grid.Column="2" Style="{StaticResource NavButton}" HorizontalAlignment="Right"
                            Margin="0,0,14,0" Command="{Binding ToggleGitHubLoginCommand}"
                            ToolTip="{Binding GitHub.ChipToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconExternal}" Width="12" Height="12" Margin="0,0,6,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding GitHub.ChipText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 계약: 창 단추는 띠 높이를 꽉 채우고 모서리에 붙는다 — 진짜 제목 표시줄과 같은 자리다 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource TitleCaptionButton}" Click="OnMinimizeClick"
                                ToolTip="{loc:Tr '최소화'}">
                            <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource IconMinimize}" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleCaptionButton}" Click="OnMaximizeClick"
                                ToolTip="{loc:Tr '최대화'}">
                            <Path x:Name="MaximizeIcon" Style="{StaticResource CaptionIcon}"
                                  Data="{StaticResource IconMaximize}" />
                        </Button>
                        <Button Style="{StaticResource TitleCloseButton}" Click="OnCloseClick"
                                ToolTip="{loc:Tr '닫기 — 트레이에 남습니다'}">
                            <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ② 알림 줄 — git 없음 · 출처 경고. 어느 화면에서든 보인다 -->
        <StackPanel Grid.Row="1" Margin="12,0,12,0">
            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,10,0,0"
                    Visibility="{Binding IsGitMissing, Converter={StaticResource BoolToVisibility}}"
                    BorderBrush="{DynamicResource DangerBrush}" Background="{DynamicResource SubtleOverlayBrush}">
                <TextBlock Text="{Binding GitVersionText}" Foreground="{DynamicResource DangerBrush}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,10,0,0"
                    Visibility="{Binding SourceNotes, Converter={StaticResource EmptyToVisibility}}">
                <TextBlock Text="{Binding SourceNotes}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- ③ 화면 — 제목 띠의 탭이 고른 하나만 보인다 -->
        <Grid Grid.Row="2">

        <!-- ── 저장소 관리 ─────────────────────────────────── -->
        <Grid x:Name="ReposPage"
              Visibility="{Binding PageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 도구줄 — 현황 칩 · 검색 · 목록 단추 -->
        <Border x:Name="RepoToolbar" Grid.Row="0" Style="{StaticResource RaisedCard}" Padding="14,10" Margin="12,10,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 현황 — 칩을 누르면 그 상태의 저장소만 남는다. 다시 누르면 전체 -->
                <ItemsControl ItemsSource="{Binding Stats}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource PillToggle}" Margin="0,0,6,0" Padding="10,4"
                                          IsChecked="{Binding IsActive, Mode=OneWay}"
                                          Command="{Binding DataContext.PickStatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"
                                          ToolTip="{loc:Tr '이 상태의 저장소만 보기 — 다시 누르면 전체'}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"
                                             Fill="{Binding Tone, Converter={StaticResource StateBrush}}"
                                             Visibility="{Binding ShowDot, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontXs}" Opacity="0.8"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSm}" Margin="7,0,0,0"
                                               FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 검색 — 알약 꼴 입력칸. 「변경된 것만」은 목록 머리의 「필터」 옆에 있다 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SearchBox}" Width="280" MaxWidth="380"
                             Tag="{loc:Tr '이름 · 묶음 · 경로로 검색'}"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 목록 단추 — 아이콘만. 뜻은 말풍선이 갖는다 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource IconButton}" Command="{Binding RescanCommand}"
                            ToolTip="{loc:Tr '목록 새로 고침'}">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconScan}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding RefreshStatusCommand}" Margin="2,0,0,0"
                            ToolTip="{loc:Tr '상태 새로 고침'}">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconRefresh}" />
                    </Button>
                    <Border Style="{StaticResource VDivider}" Height="20" Margin="7,0" />
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="OnSettingsClick"
                            ToolTip="{loc:Tr '설정'}">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconGear}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3단 — 저장소 · 상세 · 변경 내용/작업 로그(접힌 채로 시작) -->
        <Grid Grid.Row="1" Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*" MinWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="42*" MinWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ActivityColumn" Width="0" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 좌: 저장소 목록 -->
            <Border Style="{StaticResource Card}" Padding="12,12,8,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 조건 거르개 단 — 그룹 · 상태 · 작업 · 브랜치. 조건마다 하나씩 골라 겹쳐 건다(MainViewModel.Facets.cs) -->
                    <!-- 계약: 거르개 단은 제자리에서 접고 편다 — 접히면 펴는 단추만 든 좁은 띠가 남는다 -->
                    <Border Grid.RowSpan="4" Margin="0,0,8,0" Padding="0,0,4,0"
                            BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SubtleOverlayBrush}"
                            Visibility="{Binding IsFacetOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" VerticalAlignment="Top"
                                Command="{Binding ToggleFacetsCommand}" ToolTip="{loc:Tr '필터 펴기'}">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconChevronRight}"
                                  Width="12" Height="12" />
                        </Button>
                    </Border>
                    <Border x:Name="FacetPanel" Grid.RowSpan="4" Width="172" Margin="0,0,10,0" Padding="0,0,8,0"
                            BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SubtleOverlayBrush}"
                            Visibility="{Binding IsFacetOpen, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26"
                                        Command="{Binding ToggleFacetsCommand}" ToolTip="{loc:Tr '필터 접기'}">
                                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconChevronLeft}"
                                          Width="12" Height="12" />
                                </Button>
                                <TextBlock Text="{loc:Tr '필터'}" Style="{StaticResource SectionTitle}" Margin="0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <!-- 계약: 끌어 온 저장소를 「그룹」 줄에 놓으면 그 그룹으로 옮겨진다 -->
                                <ItemsControl ItemsSource="{Binding Facets}" AllowDrop="True"
                                              DragOver="OnGroupDragOver" Drop="OnGroupDrop">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <!-- 계약: 묶음 머리의 톱니는 「그룹」에만 붙는다 — 그룹 관리 쪽지를 연다 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Style="{StaticResource GroupHeader}"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   FontSize="{StaticResource FontSm}" VerticalAlignment="Center" />
                                                    </ToggleButton>
                                                    <Button Grid.Column="1" Width="22" Height="22" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ToggleGroupManagerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="{loc:Tr '그룹 만들기 · 이름 바꾸기 · 지우기'}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Key}" Value="group">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconGear}"
                                                              Width="12" Height="12" />
                                                    </Button>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Items}"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource GhostButton}" Padding="6,3"
                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                    Command="{Binding DataContext.PickFacetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Mark}" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                               FontSize="{StaticResource FontXs}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                                                               FontSize="{StaticResource FontXs}" TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                                <Style.Triggers>
                                                                                    <!-- 계약: Level 1 은 「브랜치」의 공통 · 저장소별 묶음 아래 줄이다 -->
                                                                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                                                                        <Setter Property="Margin" Value="12,0,0,0" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Micro}"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!--
                          그룹 관리 쪽지 - 만들기 / 이름 바꾸기 / 지우기(2026-10-11 사용자 지시).
                          계약: 저장소를 그룹에 넣고 빼는 길은 그대로 끌어 놓기 / 줄 쪽지다 - 여기는 그룹 자체만 다룬다.
                          계약: 안에 고르는 상자가 없어 StaysOpen=False 로 둔다 - 바깥을 누르면 닫힌다(줄 쪽지와 다른 점).
                        -->
                        <Popup x:Name="GroupManagePopup" PlacementTarget="{Binding ElementName=FacetPanel}"
                               Placement="Right" HorizontalOffset="-6" VerticalOffset="28"
                               IsOpen="{Binding IsGroupManagerOpen, Mode=TwoWay}" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12" Width="316"
                                    Margin="0,0,14,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000" />
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr '그룹 관리'}" Style="{StaticResource SectionTitle}" Margin="0"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="22" Height="22"
                                                Command="{Binding ToggleGroupManagerCommand}" ToolTip="{loc:Tr '닫기'}">
                                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconClose}"
                                                  Width="9" Height="9" />
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding ManagedGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Micro}"
                                                               Margin="8,0,2,0" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                            Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{loc:Tr '이 이름으로 바꿉니다 — 든 저장소가 함께 따라갑니다'}">
                                                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCheck}"
                                                              Width="11" Height="11" />
                                                    </Button>
                                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="7,3"
                                                            Margin="2,0,0,0" Content="&#x2715;"
                                                            Visibility="{Binding IsUserGroup, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Key}"
                                                            ToolTip="{loc:Tr '이 그룹을 지웁니다 — 저장소는 남습니다'}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Style="{StaticResource HDivider}" Margin="0,7" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Tag="{loc:Tr '새 그룹 이름'}"
                                                 Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"
                                                Padding="10,4" Content="{loc:Tr '만들기'}" Command="{Binding AddGroupCommand}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,7,0,0"
                                               Text="{loc:Tr '만든 그룹은 비어 있습니다 — 저장소 줄을 끌어다 놓으면 들어갑니다. 폴더 이름에서 온 그룹은 이름만 바꿀 수 있습니다.'}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 계약: 제목(「저장소」 · 고른 수)이 먼저, 목록을 좁히는 「변경된 것만」이 그 뒤다 — 거르개 단 여닫기는 그 단이 갖는다 -->
                        <TextBlock Text="{loc:Tr '저장소'}" Style="{StaticResource SectionTitle}" Margin="0"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="8,0,0,0"
                                ToolTip="{loc:Tr '고른 수 / 보이는 수'}">
                            <TextBlock Style="{StaticResource ChipText}">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Rows.Count, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <ToggleButton Grid.Column="2" Style="{StaticResource PillToggle}" Padding="9,3" Margin="10,0,0,0"
                                      HorizontalAlignment="Left" FontSize="{StaticResource FontXs}"
                                      Content="{loc:Tr '변경된 것만'}" IsChecked="{Binding ChangedOnly}"
                                      ToolTip="{loc:Tr '변경·충돌·앞섬·뒤처짐이 있는 저장소만 남깁니다'}" />

                        <!-- 목록 보기 — 정렬 · 그룹 모두 펴기/접기 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource PillToggle}" Padding="9,3" Margin="0,0,4,0" VerticalAlignment="Center"
                                          Content="{loc:Tr '요약 보기'}" IsChecked="{Binding IsSummaryView}"
                                          ToolTip="{loc:Tr '저장소 한 줄을 두 줄로 줄여 한 화면에 더 많이 보입니다'}" />
                            <Button Style="{StaticResource GhostButton}" Padding="7,3" Command="{Binding CycleSortCommand}"
                                    ToolTip="{loc:Tr '그룹 안 정렬 바꾸기 — 이름 · 상태 · 최근 커밋'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconSort}"
                                          Width="12" Height="12" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding SortLabel}" FontSize="{StaticResource FontXs}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="2,0,0,0"
                                    Command="{Binding ExpandAllGroupsCommand}" ToolTip="{loc:Tr '그룹 모두 펴기'}">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconExpandAll}"
                                      Width="13" Height="13" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Command="{Binding CollapseAllGroupsCommand}" ToolTip="{loc:Tr '그룹 모두 접기'}">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCollapseAll}"
                                      Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 거르는 중 표시 + 그룹 옮기기 -->
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 계약: 그룹·상태로 거르는 중이면 무엇으로 거르는지 적고 한 번에 풀게 한다 -->
                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Padding="9,3,4,3"
                                Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ActiveFilterText}" Style="{StaticResource ChipText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                <Button Style="{StaticResource IconButton}" Width="20" Height="20" Margin="4,0,0,0"
                                        Command="{Binding ClearFiltersCommand}" ToolTip="{loc:Tr '거르개 풀기'}">
                                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconClose}"
                                          Width="9" Height="9" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Micro}" VerticalAlignment="Center"
                                   Text="{loc:Tr '저장소를 끌어 다른 그룹에 놓거나 두 번 눌러 옮깁니다'}"
                                   Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <!-- 그룹 옮기기 쪽지 -->
                        <Popup x:Name="GroupPopup" PlacementTarget="{Binding ElementName=GroupButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               VerticalOffset="4">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12" Width="268">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr '고른 저장소를 옮길 그룹'}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text="개가 선택돼 있습니다." />
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding GroupChips}" MaxHeight="220">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,3"
                                                      Visibility="{Binding Key, Converter={StaticResource NullToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                            Content="{Binding Label}"
                                                            Command="{Binding DataContext.MoveSelectedToGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Key}" />
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="7,3"
                                                            Content="✕" ToolTip="{loc:Tr '이 그룹을 지웁니다 — 저장소는 남습니다'}"
                                                            Visibility="{Binding IsUserGroup, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Key}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Style="{StaticResource HDivider}" Margin="0,6" />

                                    <TextBox Tag="{loc:Tr '새 그룹 이름'}" Margin="0,0,0,6"
                                             Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button x:Name="CreateGroupButton" Style="{StaticResource PrimaryButton}"
                                            Content="{loc:Tr '새 그룹으로 옮기기'}"
                                            Command="{Binding CreateGroupCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                                            Content="{loc:Tr '그룹에서 빼기'}"
                                            Command="{Binding MoveSelectedToGroupCommand}" CommandParameter="" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!--
                          줄 하나 고치기 쪽지 — 줄을 두 번 누르거나 줄의 톱니를 누르면 뜬다(MainWindow.Repos.cs).
                          계약: 셋 다 있는 것 중에서 고르고, 고르는 즉시 반영된다(MainViewModel.Branches.cs).
                          함정: StaysOpen=False 로 두면 안쪽 고르는 상자를 편 뒤 쪽지가 제멋대로 닫히거나 안 닫힌다 — 닫기는 코드가 맡는다.
                        -->
                        <Popup x:Name="RowPopup" Placement="MousePoint" StaysOpen="True" AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="12" Width="300"
                                    Margin="0,0,14,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000" />
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding EditRow.Name}" Style="{StaticResource SectionTitle}" Margin="0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="22" Height="22"
                                                Click="OnRowPopupCloseClick" ToolTip="{loc:Tr '닫기'}">
                                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconClose}"
                                                  Width="9" Height="9" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{loc:Tr '그룹'}" Style="{StaticResource Micro}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding EditGroupOptions}" SelectedValuePath="Value"
                                              DisplayMemberPath="Label" SelectedValue="{Binding EditGroup}"
                                              MaxDropDownHeight="300" Margin="0,0,0,8" />

                                    <TextBlock Text="{loc:Tr '작업 브랜치'}" Style="{StaticResource Micro}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding EditWorkOptions}" SelectedValuePath="Value"
                                              DisplayMemberPath="Label" SelectedValue="{Binding EditWork}"
                                              MaxDropDownHeight="300" Margin="0,0,0,8" />

                                    <TextBlock Text="{loc:Tr '업로드 브랜치'}" Style="{StaticResource Micro}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding EditUploadOptions}" SelectedValuePath="Value"
                                              DisplayMemberPath="Label" SelectedValue="{Binding EditUpload}"
                                              MaxDropDownHeight="300" Margin="0,0,0,8" />

                                    <TextBlock Style="{StaticResource Micro}" TextWrapping="Wrap"
                                               Text="{loc:Tr '고르는 즉시 저장됩니다. 「공통 설정 따름」이면 아래 띠의 값을 씁니다.'}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 고르기 │ 고른 것에 하는 일 — 두 묶음으로 가른다 -->
                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,0,4,8">
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Tr '모두 선택'}"
                                Command="{Binding SelectAllCommand}" Margin="0,0,4,4" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Tr '선택 해제'}"
                                Command="{Binding SelectNoneCommand}" Margin="0,0,4,4" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Tr '변경된 것만 선택'}"
                                Command="{Binding SelectChangedCommand}" Margin="0,0,4,4" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Tr '작업 중만 선택'}"
                                Command="{Binding SelectMineCommand}" Margin="0,0,4,4" />
                        <Border Style="{StaticResource VDivider}" Height="18" Margin="3,0,7,4" />
                        <Button x:Name="GroupButton" Style="{StaticResource GhostButton}"
                                Margin="0,0,4,4" Click="OnGroupPopupClick"
                                ToolTip="{loc:Tr '고른 저장소를 그룹으로 옮깁니다'}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFolder}"
                                      Width="12" Height="12" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr '그룹으로 옮기기'}" FontSize="{StaticResource FontXs}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Tr '작업 중 표시'}"
                                Command="{Binding ToggleMineCommand}" Margin="0,0,4,4"
                                ToolTip="{loc:Tr '고른 저장소를 내가 작업 중인 저장소로 찍습니다 — 모두 찍혀 있으면 풉니다'}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding HideSelectedCommand}"
                                Margin="0,0,0,4" ToolTip="{loc:Tr '고른 저장소를 목록에서 숨깁니다 — 설정에서 되살립니다'}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconHide}"
                                      Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr '목록에서 숨기기'}" FontSize="{StaticResource FontXs}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <ListBox x:Name="RepoList" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                             ItemContainerStyle="{Binding Settings.CompactRows, Converter={StaticResource RowStyle}}"
                             ScrollViewer.CanContentScroll="False" Padding="0,0,4,0"
                             AllowDrop="True" DragOver="OnGroupDragOver" Drop="OnGroupDrop"
                             PreviewMouseLeftButtonDown="OnRepoListMouseDown" PreviewMouseMove="OnRepoListMouseMove"
                             MouseDoubleClick="OnRepoListDoubleClick">

                        <!--
                          계약: 목록은 그룹으로 묶여 뿌려진다 — 묶는 열쇠가 GroupNode 객체라 머리가 {Binding Name.…} 으로 접힘·건수를 읽는다.
                          함정: 묶인 목록은 CanContentScroll 이 켜져 있으면 그룹 단위로 뚝뚝 넘어간다 — 꺼서 픽셀 단위로 굴린다.
                        -->
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel Margin="0,0,0,6">
                                                        <ToggleButton Style="{StaticResource GroupHeader}"
                                                                      IsChecked="{Binding Name.IsExpanded, Mode=TwoWay}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox IsChecked="{Binding Name.AllSelected, Mode=TwoWay}"
                                                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                                                          ToolTip="{loc:Tr '이 그룹의 저장소를 모두 고르거나 풉니다'}" />
                                                                <Path Grid.Column="1" Data="{StaticResource IconFolder}"
                                                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"
                                                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                                                      StrokeLineJoin="Round" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name.Label}" FontWeight="SemiBold"
                                                                               FontSize="{StaticResource FontSm}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="6,1">
                                                                        <TextBlock Text="{Binding Name.CountText}"
                                                                                   Style="{StaticResource ChipText}" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- 그룹 요약 — 0 인 칸은 숨긴다 -->
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                                                ToolTip="{loc:Tr '문제·충돌이 있는 저장소'}"
                                                                                Visibility="{Binding Name.Problem, Converter={StaticResource CountToVisibility}}">
                                                                        <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                 Fill="{DynamicResource DangerBrush}" />
                                                                        <TextBlock Text="{Binding Name.Problem}" Style="{StaticResource Micro}"
                                                                                   FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                                                ToolTip="{loc:Tr '받을 것이 있는 저장소'}"
                                                                                Visibility="{Binding Name.Behind, Converter={StaticResource CountToVisibility}}">
                                                                        <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                 Fill="{DynamicResource BehindBrush}" />
                                                                        <TextBlock Text="{Binding Name.Behind}" Style="{StaticResource Micro}"
                                                                                   FontWeight="SemiBold" Foreground="{DynamicResource BehindBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                                                ToolTip="{loc:Tr '올릴 것이 있는 저장소'}"
                                                                                Visibility="{Binding Name.Ahead, Converter={StaticResource CountToVisibility}}">
                                                                        <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                 Fill="{DynamicResource AheadBrush}" />
                                                                        <TextBlock Text="{Binding Name.Ahead}" Style="{StaticResource Micro}"
                                                                                   FontWeight="SemiBold" Foreground="{DynamicResource AheadBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                                                ToolTip="{loc:Tr '변경이 있는 저장소'}"
                                                                                Visibility="{Binding Name.Dirty, Converter={StaticResource CountToVisibility}}">
                                                                        <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                                 Fill="{DynamicResource DirtyBrush}" />
                                                                        <TextBlock Text="{Binding Name.Dirty}" Style="{StaticResource Micro}"
                                                                                   FontWeight="SemiBold" Foreground="{DynamicResource DirtyBrush}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </ToggleButton>
                                                        <ItemsPresenter Margin="8,3,0,0"
                                                                        Visibility="{Binding Name.IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepoRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,9,0" />

                                    <StackPanel Grid.Column="1">
                                        <!-- 첫 줄 — 이름 · 상태 알약 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 함정: 기본 Button 의 MinHeight 32 가 Height 를 이긴다 — 0 으로 풀지 않으면 이름 줄만 32px 가 된다 -->
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="18" Height="18" MinHeight="0"
                                                    Margin="3,0,0,0" Click="OnRowEditClick"
                                                    ToolTip="{loc:Tr '이 저장소의 그룹 · 작업 브랜치 · 업로드 브랜치 고르기'}">
                                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconGear}"
                                                      Width="11" Height="11" />
                                            </Button>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Text="★" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontXs}" Foreground="{DynamicResource AccentBrush}"
                                                           ToolTip="{loc:Tr '작업 중으로 찍은 저장소'}"
                                                           Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <!-- 왜: 돌고 있는 저장소를 점 세 개가 아니라 작은 막대로 보여 준다 — 줄 높이가 흔들리지 않는다 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar Width="26" Height="3" IsIndeterminate="True"
                                                             VerticalAlignment="Center" Margin="6,0,0,0"
                                                             Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                                                <!-- 계약: 이 저장소를 다시 조회한 시각 — 새로 고침·일괄 작업 뒤에 저장소마다 다시 찍힌다 -->
                                                <TextBlock Text="{Binding RefreshedClockText}" Style="{StaticResource Micro}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" ToolTip="{Binding RefreshedExactText}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="7,1"
                                                    Background="{DynamicResource SubtleOverlayBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                                             Fill="{Binding StateText, Converter={StaticResource StateBrush}}" />
                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource ChipText}"
                                                               Foreground="{Binding StateText, Converter={StaticResource StateBrush}}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 둘째 줄 — 브랜치 · 올릴 것/받을 것 · 변경 내역 -->
                                        <!-- 계약: 「요약 보기」(IsSummaryView)에서는 줄이 여기까지다 — 마지막 결과를 이 줄 오른쪽에 붙이고 셋째·넷째 줄을 접는다 -->
                                        <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Margin="10,0,0,0"
                                                Visibility="{Binding DataContext.IsSummaryView, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Micro}" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{Binding LastOutcome, Converter={StaticResource OutcomeBrush}}"
                                                       Text="{Binding LastResult}" ToolTip="{Binding LastResult}"
                                                       Visibility="{Binding LastResult, Converter={StaticResource EmptyToVisibility}}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconBranch}" Width="10" Height="10" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding BranchText}" Style="{StaticResource Mono}"
                                                       FontSize="{StaticResource FontXs}" VerticalAlignment="Center"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                        ToolTip="{loc:Tr '올릴 커밋 수'}"
                                                        Visibility="{Binding Ahead, Converter={StaticResource CountToVisibility}}">
                                                <Path Data="{StaticResource IconUp}" Width="9" Height="9" Stretch="Uniform"
                                                      Stroke="{DynamicResource AheadBrush}" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Ahead}" Style="{StaticResource Micro}" Margin="2,0,0,0"
                                                           FontWeight="Bold" Foreground="{DynamicResource AheadBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                                        ToolTip="{loc:Tr '받을 커밋 수'}"
                                                        Visibility="{Binding Behind, Converter={StaticResource CountToVisibility}}">
                                                <Path Data="{StaticResource IconDown}" Width="9" Height="9" Stretch="Uniform"
                                                      Stroke="{DynamicResource BehindBrush}" StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Behind}" Style="{StaticResource Micro}" Margin="2,0,0,0"
                                                           FontWeight="Bold" Foreground="{DynamicResource BehindBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SyncNote}" Style="{StaticResource Micro}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding SyncNote, Converter={StaticResource EmptyToVisibility}}" />
                                            <TextBlock Text="·" Style="{StaticResource Micro}" Margin="7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ChangeText}" Style="{StaticResource Caption}"
                                                       FontSize="{StaticResource FontXs}" VerticalAlignment="Center" />
                                            <!-- 계약: 이 저장소만 따로 정한 브랜치가 있을 때만 보인다 — 없으면 공통 값을 따른다 -->
                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1"
                                                    ToolTip="{loc:Tr '이 저장소만 따로 정한 브랜치'}"
                                                    Visibility="{Binding BranchRuleText, Converter={StaticResource EmptyToVisibility}}">
                                                <TextBlock Text="{Binding BranchRuleText}" Style="{StaticResource ChipText}"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        </Grid>

                                        <StackPanel Visibility="{Binding DataContext.IsSummaryView, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <!-- 셋째 줄 — 마지막 커밋(날짜 · 경과 · 제목). 상태를 읽은 때는 이름 줄 오른쪽에 날짜·경과로 있다 -->
                                        <TextBlock Text="{Binding LastCommitLine}" Style="{StaticResource Micro}" Margin="0,1,0,0"
                                                   ToolTip="{Binding LastCommitText}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding LastOutcome, Converter={StaticResource OutcomeBrush}}"
                                                   Text="{Binding LastResult}"
                                                   Visibility="{Binding LastResult, Converter={StaticResource EmptyToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="9" />

            <!-- 중: 고른 저장소의 상세 -->
            <Border x:Name="DetailPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="14,14,10,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 아무것도 안 고른 상태 -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,24,0,0"
                                Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                        <Path Data="{StaticResource IconBranch}" Width="30" Height="30" Stretch="Uniform"
                              Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Tr '저장소를 고르면 상태가 여기에 보입니다.'}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" DataContext="{Binding SelectedRow}"
                                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center"
                                     Fill="{Binding StateText, Converter={StaticResource StateBrush}}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Subtitle}" />
                            <Border Style="{StaticResource Chip}" Margin="11,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBranch}" Width="11" Height="11" Stretch="Uniform"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding BranchText}" Style="{StaticResource ChipText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding AheadBehindText}" Style="{StaticResource Caption}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Micro}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" Margin="18,5,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LastCommitText}" Style="{StaticResource Micro}" Margin="18,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RefreshedExactText}" Style="{StaticResource Micro}" Margin="18,2,0,0" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,12,0,8"
                               IsEnabled="{Binding SelectedRow, Converter={StaticResource NullToBool}}">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconFolder}" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr '폴더'}" FontSize="{StaticResource FontXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenTerminalCommand}" Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconTerminal}" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr '터미널'}" FontSize="{StaticResource FontXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenDesktopCommand}" Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconDesktop}" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="GitHub Desktop" FontSize="{StaticResource FontXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenCodeCommand}" Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCode}" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="VS Code" FontSize="{StaticResource FontXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenRemoteCommand}" Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconExternal}" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr '원격 페이지'}" FontSize="{StaticResource FontXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <!-- 계약: 원격이 없는 저장소에만 보인다 — 일괄 작업의 「원격 없음」 건너뜀이 이 단추를 깜빡인다(Nudge publish) -->
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenPublishCommand}" Margin="0,0,4,4"
                                controls:Nudge.Key="publish" controls:Nudge.Active="{Binding NudgeAction}"
                                Visibility="{Binding SelectedRow.IsLocalOnly, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconExternal}" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr 'GitHub 에 올리기'}" FontSize="{StaticResource FontXs}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding CopyPathCommand}" Margin="0,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCopy}" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr '경로 복사'}" FontSize="{StaticResource FontXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding CopyBranchCommand}" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCopy}" Width="13" Height="13" Margin="0,0,5,0" />
                                <TextBlock Text="{loc:Tr '브랜치 이름 복사'}" FontSize="{StaticResource FontXs}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TabControl Grid.Row="2" SelectedIndex="{Binding DetailTabIndex}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr '변경 파일'}" />
                                    <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="6,1"
                                            Visibility="{Binding Changes.Count, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding Changes.Count}" Style="{StaticResource ChipText}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.RowSpan="2" Text="{loc:Tr '변경이 없습니다.'}" Style="{StaticResource Caption}" Margin="4,14,0,0"
                                           Visibility="{Binding Changes.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                <!-- 확장자 거르개 — 확장자가 둘 이상일 때만 줄이 생긴다(MainViewModel.ChangeFilter.cs) -->
                                <ItemsControl ItemsSource="{Binding ChangeExtensions}" Margin="0,8,0,0"
                                              Visibility="{Binding ChangeExtensions.Count, Converter={StaticResource CountToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Padding="6,3" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.PickChangeExtCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Mark}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                               FontSize="{StaticResource FontXs}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="{StaticResource FontXs}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Count}" Style="{StaticResource Micro}" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Changes}" Margin="0,8,0,0"
                                         SelectedItem="{Binding SelectedChange}"
                                         ItemContainerStyle="{Binding Settings.CompactRows, Converter={StaticResource RowStyle}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Padding="7,1"
                                                        Background="{DynamicResource SubtleOverlayBrush}">
                                                    <TextBlock Text="{Binding Converter={StaticResource ChangeKind}}"
                                                               Style="{StaticResource ChipText}"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" Style="{StaticResource Mono}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <!-- 계약: 추가는 녹색·삭제는 적색이다 — 못 센 줄은 글자가 비어 자리를 차지하지 않는다 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                                                    <TextBlock Text="{Binding AddedText}" Style="{StaticResource Mono}"
                                                               Foreground="{DynamicResource OkBrush}" />
                                                    <TextBlock Text="{Binding RemovedText}" Style="{StaticResource Mono}" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                    <TextBlock Text="{Binding LineNote}" Style="{StaticResource Micro}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- 계약: 왼쪽에서 브랜치를 고르면 오른쪽에 그 브랜치의 커밋 이력이 뜬다 — 두 번 누르면 묻고 Switch 한다(MainViewModel.BranchLog.cs) -->
                        <TabItem Header="{loc:Tr '브랜치'}">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38*" MinWidth="200" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="62*" MinWidth="260" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Tr '두 번 누르면 그 브랜치로 Switch'}" Style="{StaticResource Micro}" Margin="2,0,0,6" />
                                <TextBlock Grid.Column="2" Text="{Binding BranchLogCaption}" Style="{StaticResource Micro}" Margin="2,0,0,6"
                                           TextTrimming="CharacterEllipsis" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                                         MouseDoubleClick="OnBranchDoubleClick"
                                         ItemContainerStyle="{Binding Settings.CompactRows, Converter={StaticResource RowStyle}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" />
                                                    <TextBlock Style="{StaticResource Micro}" Margin="0,1,0,0">
                                                        <Run Text="{Binding Upstream, Mode=OneWay, TargetNullValue='추적 없음'}" />
                                                        <Run Text=" · 앞섬 " /><Run Text="{Binding Ahead, Mode=OneWay}" />
                                                        <Run Text=" · 뒤처짐 " /><Run Text="{Binding Behind, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource Micro}" VerticalAlignment="Center"
                                                           Text="{Binding LastCommitWhen, StringFormat={}{0:yyyy-MM-dd}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ListBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding BranchCommits}"
                                         ItemContainerStyle="{Binding Settings.CompactRows, Converter={StaticResource RowStyle}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ShortSha}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Commit.Subject}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Commit.Subject}" />
                                                    <TextBlock Style="{StaticResource Micro}" Margin="0,1,0,0">
                                                        <Run Text="{Binding WhenText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Commit.Author, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="6,1" Margin="8,0,0,0"
                                                        Visibility="{Binding Pushed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                        ToolTip="{loc:Tr '아직 원격에 없는 커밋입니다 — Push 하면 사라집니다'}">
                                                    <TextBlock Text="{loc:Tr 'Push 전'}" Style="{StaticResource ChipText}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem controls:Nudge.Key="conflict" controls:Nudge.Active="{Binding NudgeAction}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr '충돌'}" />
                                    <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="6,1"
                                            Background="{DynamicResource DangerBrush}"
                                            Visibility="{Binding Conflicts.Count, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding Conflicts.Count}" Style="{StaticResource ChipText}"
                                                   Foreground="{DynamicResource PanelBrush}" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 계약: 자동 판정은 미리 골라 두기만 한다 — 파일은 「적용」을 눌러야 바뀌고, 이전 파일은 .git/jhj-conflict-backup 에 남는다 -->
                                <DockPanel Margin="4,10,4,0" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                            Command="{Binding ConcludeMergeCommand}"
                                            ToolTip="{loc:Tr '충돌이 다 풀린 병합을 커밋으로 맺습니다'}"
                                            Visibility="{Binding CanConcludeMerge, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{loc:Tr '병합 마무리'}" FontSize="{StaticResource FontXs}" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                            Command="{Binding ApplyReadyConflictsCommand}"
                                            ToolTip="{loc:Tr '구간을 전부 고른 파일만 다시 쓰고 스테이지합니다 — 이전 파일은 백업됩니다'}"
                                            Visibility="{Binding Conflicts.Count, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{loc:Tr '고른 것 모두 적용'}" FontSize="{StaticResource FontXs}" />
                                    </Button>
                                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="{loc:Tr '자동으로 풀 수 있는 구간은 미리 골라 두었습니다. 나머지를 고른 뒤 적용해 주십시오.'}"
                                               Visibility="{Binding Conflicts.Count, Converter={StaticResource CountToVisibility}}" />
                                </DockPanel>

                                <TextBlock Grid.Row="1" Text="{loc:Tr '충돌이 없습니다.'}" Style="{StaticResource Caption}" Margin="4,14,0,0"
                                           Visibility="{Binding Conflicts.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                    <StackPanel>
                                    <!-- 계약: 차이 요약은 세 층이다 — 저장소(여기) · 파일 · 구간. 값은 MainViewModel.Conflicts.cs 가 센다 -->
                                    <Border Style="{StaticResource Chip}" Padding="10,5" Margin="0,0,4,8" HorizontalAlignment="Left"
                                            Visibility="{Binding Conflicts.Count, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="{Binding ConflictOverview}" FontSize="{StaticResource FontXs}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Conflicts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Margin="0,0,4,8" Padding="12">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                                    IsEnabled="{Binding IsReady}"
                                                                    Command="{Binding DataContext.ApplyConflictFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Tr '이 파일을 고른 대로 다시 쓰고 스테이지합니다'}">
                                                                <TextBlock Text="{loc:Tr '이 파일 적용'}" FontSize="{StaticResource FontXs}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Button>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Micro}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}"
                                                                       FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding DiffSummary}" Style="{StaticResource Micro}" Margin="0,3,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding DiffSummary, Converter={StaticResource EmptyToVisibility}}" />
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding Note, Converter={StaticResource EmptyToVisibility}}" />
                                                        <ItemsControl ItemsSource="{Binding Hunks}" Margin="0,8,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,0,0,12">
                                                                        <WrapPanel>
                                                                            <TextBlock Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                <Run Text="{Binding StartLine, Mode=OneWay}" /><Run Text="줄" />
                                                                            </TextBlock>
                                                                            <Border Style="{StaticResource Chip}" Padding="7,1" Margin="0,0,8,0"
                                                                                    Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"
                                                                                    Visibility="{Binding IsCertain, Converter={StaticResource BoolToVisibility}}">
                                                                                <TextBlock Text="{loc:Tr '자동'}" Style="{StaticResource ChipText}"
                                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                                                                        </WrapPanel>
                                                                        <WrapPanel Margin="0,5,0,0">
                                                                            <ToggleButton Style="{StaticResource PillToggle}" Padding="9,3" Margin="0,0,5,0"
                                                                                          Content="{loc:Tr '내 것'}" IsChecked="{Binding IsOurs, Mode=TwoWay}" />
                                                                            <ToggleButton Style="{StaticResource PillToggle}" Padding="9,3" Margin="0,0,5,0"
                                                                                          Content="{loc:Tr '상대 것'}" IsChecked="{Binding IsTheirs, Mode=TwoWay}" />
                                                                            <ToggleButton Style="{StaticResource PillToggle}" Padding="9,3" Margin="0,0,5,0"
                                                                                          Content="{loc:Tr '둘 다'}" IsChecked="{Binding IsBoth, Mode=TwoWay}"
                                                                                          ToolTip="{loc:Tr '내 것 다음에 상대 것을 이어 붙입니다'}" />
                                                                            <ToggleButton Style="{StaticResource PillToggle}" Padding="9,3"
                                                                                          Content="{loc:Tr '합치기'}" IsChecked="{Binding IsMerged, Mode=TwoWay}"
                                                                                          ToolTip="{loc:Tr '양쪽이 서로 다른 줄을 고쳐 줄 단위로 합친 결과입니다'}"
                                                                                          Visibility="{Binding CanMerge, Converter={StaticResource BoolToVisibility}}" />
                                                                        </WrapPanel>
                                                                        <TextBlock Text="{Binding DiffSummary}" Style="{StaticResource Micro}" Margin="0,5,0,0"
                                                                                   TextWrapping="Wrap" />
                                                                        <!-- 계약: 구간마다 코드는 셋을 보인다 — 갈라지기 전(공통 조상) · 내 것 · 상대 것. 조상은 있을 때만 -->
                                                                        <Border BorderThickness="3,0,0,0" Padding="9,5" Margin="0,6,0,0"
                                                                                CornerRadius="0,6,6,0"
                                                                                BorderBrush="{DynamicResource DividerBrush}"
                                                                                Background="{DynamicResource SubtleOverlayBrush}"
                                                                                Visibility="{Binding HasBase, Converter={StaticResource BoolToVisibility}}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{loc:Tr '갈라지기 전 (공통 조상)'}" Style="{StaticResource Micro}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBlock Text="{Binding Base, Converter={StaticResource Lines}}"
                                                                                           Style="{StaticResource Mono}" TextWrapping="Wrap"
                                                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border BorderThickness="3,0,0,0" Padding="9,5" Margin="0,3,0,0"
                                                                                CornerRadius="0,6,6,0"
                                                                                BorderBrush="{DynamicResource AheadBrush}"
                                                                                Background="{DynamicResource SubtleOverlayBrush}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{loc:Tr '내 것 (지금 브랜치)'}" Style="{StaticResource Micro}"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource AheadBrush}" />
                                                                                <TextBlock Text="{Binding Ours, Converter={StaticResource Lines}}"
                                                                                           Style="{StaticResource Mono}" TextWrapping="Wrap"
                                                                                           Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border BorderThickness="3,0,0,0" Padding="9,5" Margin="0,3,0,0"
                                                                                CornerRadius="0,6,6,0"
                                                                                BorderBrush="{DynamicResource BehindBrush}"
                                                                                Background="{DynamicResource SubtleOverlayBrush}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{loc:Tr '상대 것 (들어오는 쪽)'}" Style="{StaticResource Micro}"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource BehindBrush}" />
                                                                                <TextBlock Text="{Binding Theirs, Converter={StaticResource Lines}}"
                                                                                           Style="{StaticResource Mono}" TextWrapping="Wrap"
                                                                                           Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border BorderThickness="3,0,0,0" Padding="9,5" Margin="0,3,0,0"
                                                                                CornerRadius="0,6,6,0"
                                                                                BorderBrush="{DynamicResource OkBrush}"
                                                                                Background="{DynamicResource SubtleOverlayBrush}"
                                                                                Visibility="{Binding CanMerge, Converter={StaticResource BoolToVisibility}}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{loc:Tr '합친 결과'}" Style="{StaticResource Micro}"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource OkBrush}" />
                                                                                <TextBlock Text="{Binding MergedLines, Converter={StaticResource Lines}}"
                                                                                           Style="{StaticResource Mono}" TextWrapping="Wrap"
                                                                                           Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!--
                          상태 — 줄에 보이는 한 단어(「올릴 것」·「변경」·「stash 2」)가 왜 그런지 풀어 적고 stash 를 펼친다.
                          계약: 읽기뿐이다(MainViewModel.Status.cs) — 여기서 git 에 쓰지 않는다.
                        -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr '상태'}" />
                                    <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="6,1"
                                            Visibility="{Binding Stashes.Count, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Style="{StaticResource ChipText}">
                                            <Run Text="stash " /><Run Text="{Binding Stashes.Count, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <ItemsControl ItemsSource="{Binding StatusReasons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Margin="2,6,10,0" VerticalAlignment="Top"
                                                             Fill="{Binding Tone, Converter={StaticResource StateBrush}}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   FontSize="{StaticResource FontSm}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Style="{StaticResource HDivider}" Margin="0,4,0,10"
                                            Visibility="{Binding Stashes.Count, Converter={StaticResource CountToVisibility}}" />

                                    <ItemsControl ItemsSource="{Binding Stashes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SubtleOverlayBrush}" CornerRadius="{StaticResource RadiusSm}"
                                                        Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Ref}" Style="{StaticResource Mono}" FontWeight="SemiBold" />
                                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1"
                                                                    Visibility="{Binding Branch, Converter={StaticResource EmptyToVisibility}}">
                                                                <TextBlock Text="{Binding Branch}" Style="{StaticResource ChipText}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding When, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                                       Style="{StaticResource Micro}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   FontSize="{StaticResource FontSm}" />
                                                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,5,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}"
                                                                               FontSize="{StaticResource FontXs}"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource Micro}" Margin="2,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Stashes.Count, Converter={StaticResource CountToVisibility}}"
                                               Text="{loc:Tr '되살리기·버리기는 터미널에서 git stash pop · git stash drop 으로 합니다 — 이 앱은 읽기만 합니다.'}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <!-- 작업 — GitHub Desktop 에 있던 한 저장소짜리 일(Clone · 브랜치 · 커밋 · stash · 태그 · 원격). 화면은 RepoToolsView 한 파일이다 -->
                        <TabItem Header="{loc:Tr '작업'}">
                            <views:RepoToolsView />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter x:Name="ActivitySplitter" Grid.Column="3" Width="9" />

            <!-- 우: 변경 내용 · 작업 로그(고른 저장소) · 시스템 작업 로그(전체) · 시스템 오류(실패·충돌) -->
            <Border x:Name="ActivityPanel" Grid.Column="4" Style="{StaticResource Card}" Padding="12,10,8,12">
                <Grid>
                <TabControl SelectedIndex="{Binding RightTabIndex}">

                    <!-- 변경 내용 — 가운데 「변경 파일」에서 고른 그 파일의 diff -->
                    <TabItem Header="{loc:Tr '변경 내용'}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 아무 파일도 안 고른 상태 -->
                            <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Margin="8,0,12,24"
                                        Visibility="{Binding SelectedChange, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                                <Path Data="{StaticResource IconCode}" Width="26" Height="26" Stretch="Uniform"
                                      Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Text="{loc:Tr '가운데 「변경 파일」에서 파일을 누르면 바뀐 내용이 여기에 보입니다.'}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Margin="0,0,8,8"
                                        Visibility="{Binding SelectedChange, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding DiffTitle}" Style="{StaticResource Mono}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DiffSummary}" Style="{StaticResource Micro}"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding DiffSummary, Converter={StaticResource EmptyToVisibility}}" />
                                    <TextBlock Text="{loc:Tr '읽는 중…'}" Style="{StaticResource Micro}" Margin="8,0,0,0"
                                               Visibility="{Binding IsDiffLoading, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DiffNote}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding DiffNote, Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>

                            <!-- 계약: 가로로는 줄 바꾸지 않고 스크롤한다 — 코드 줄은 접으면 읽기 어렵다 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto" Margin="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding DiffLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Kind, Converter={StaticResource DiffBack}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding OldNoText}" Width="34" TextAlignment="Right"
                                                               Style="{StaticResource Mono}" FontSize="{StaticResource FontXs}"
                                                               Foreground="{DynamicResource TextFaintBrush}" />
                                                    <TextBlock Text="{Binding NewNoText}" Width="34" TextAlignment="Right"
                                                               Margin="4,0,0,0"
                                                               Style="{StaticResource Mono}" FontSize="{StaticResource FontXs}"
                                                               Foreground="{DynamicResource TextFaintBrush}" />
                                                    <TextBlock Text="{Binding Kind, Converter={StaticResource DiffSign}}"
                                                               Width="14" TextAlignment="Center" Margin="6,0,0,0"
                                                               Style="{StaticResource Mono}" FontWeight="Bold"
                                                               Foreground="{Binding Kind, Converter={StaticResource DiffFore}}" />
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Mono}"
                                                               Foreground="{Binding Kind, Converter={StaticResource DiffFore}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!--
                      작업 로그 — 고른 저장소의 일만. 전체는 셋째 탭이 갖는다(2026-10-11 사용자 지시).
                      계약: 저장소를 가리는 열쇠는 ActivityEntry.RepoId 다 — 목록·그룹처럼 저장소가 없는 일은 셋째 탭에만 보인다.
                    -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr '작업 로그'}" />
                                <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="6,1"
                                        Visibility="{Binding RepoActivity.Count, Converter={StaticResource CountToVisibility}}">
                                    <TextBlock Text="{Binding RepoActivity.Count}" Style="{StaticResource ChipText}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding SelectedRow.Name}" Style="{StaticResource Micro}"
                                       Margin="2,0,8,4" TextTrimming="CharacterEllipsis" />

                            <Grid Grid.Row="1">
                                <TextBlock Style="{StaticResource Caption}" Margin="4,8,8,0" TextWrapping="Wrap"
                                           Text="{loc:Tr '이 저장소에 대한 작업 기록이 아직 없습니다. 전체 기록은 「시스템 작업 로그」 탭에 있습니다.'}"
                                           Visibility="{Binding RepoActivity.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                <ContentControl Content="{Binding RepoLog}" Focusable="False"
                                                ContentTemplate="{StaticResource ActivityLogPane}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 시스템 작업 로그 — 저장소를 가리지 않은 전체 기록(목록 훑기·그룹 바꾸기까지) -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr '시스템 작업 로그'}" />
                                <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="6,1"
                                        Visibility="{Binding Activity.Count, Converter={StaticResource CountToVisibility}}">
                                    <TextBlock Text="{Binding Activity.Count}" Style="{StaticResource ChipText}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,4"
                                        Visibility="{Binding Activity.Count, Converter={StaticResource CountToVisibility}}">
                                <Button Style="{StaticResource GhostButton}" Padding="7,2" Content="{loc:Tr '오류 보고'}"
                                        Command="{Binding ReportErrorCommand}"
                                        Visibility="{Binding HasReportableError, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{loc:Tr '실패한 작업 기록 · 환경 · 설정 · 이벤트 로그를 한 벌로 복사하고 이슈 양식을 엽니다 — 저장소 경로와 원격 주소는 가립니다'}" />
                                <Button Style="{StaticResource GhostButton}" Padding="7,2" Content="{loc:Tr '지우기'}"
                                        Command="{Binding ClearActivityCommand}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <TextBlock Text="{loc:Tr '작업이 없습니다.'}" Style="{StaticResource Caption}" Margin="4,8,0,0"
                                           Visibility="{Binding Activity.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                <ContentControl Content="{Binding SystemLog}" Focusable="False"
                                                ContentTemplate="{StaticResource ActivityLogPane}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 시스템 오류 — 전체 기록에서 실패·충돌만 남긴 것. 무엇이 막혔는지 이 탭 하나로 본다 -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Tr '시스템 오류'}" />
                                <Border Style="{StaticResource Chip}" Margin="7,0,0,0" Padding="6,1"
                                        Visibility="{Binding ErrorLog.TotalCount, Converter={StaticResource CountToVisibility}}">
                                    <TextBlock Text="{Binding ErrorLog.TotalCount}" Style="{StaticResource ChipText}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,4"
                                        Visibility="{Binding HasReportableError, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource GhostButton}" Padding="7,2" Content="{loc:Tr '오류 보고'}"
                                        Command="{Binding ReportErrorCommand}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <TextBlock Text="{loc:Tr '실패하거나 충돌로 멈춘 작업이 없습니다.'}" Style="{StaticResource Caption}"
                                           Margin="4,8,8,0" TextWrapping="Wrap"
                                           Visibility="{Binding ErrorLog.TotalCount, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                <ContentControl Content="{Binding ErrorLog}" Focusable="False"
                                                ContentTemplate="{StaticResource ActivityLogPane}" />
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- 접기 — 탭 줄 오른쪽 끝에 얹는다 -->
                <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="0,2,2,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding ToggleRightPanelCommand}" ToolTip="{loc:Tr '이 단 접기'}">
                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconChevronRight}"
                          Width="12" Height="12" />
                </Button>
                </Grid>
            </Border>

            <!--
              접힌 오른쪽 단의 손잡이 — 처음에는 이것만 보인다.
              계약: 변경 파일을 누르면 저절로 펴진다(MainViewModel.OnSelectedChangeChanged). 여기 단추는 손으로 펴는 길이다.
            -->
            <Border x:Name="ActivityRail" Grid.Column="5" Style="{StaticResource Card}" Padding="4,8" Margin="9,0,0,0">
                <StackPanel>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleRightPanelCommand}"
                            ToolTip="{loc:Tr '변경 내용 · 작업 로그 · 시스템 작업 로그 펴기'}">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconChevronLeft}" />
                    </Button>
                    <Border Style="{StaticResource HDivider}" Margin="5,6" />
                    <Button Style="{StaticResource IconButton}" Command="{Binding ShowRightTabCommand}"
                            CommandParameter="0" ToolTip="{loc:Tr '변경 내용'}">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCode}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ShowRightTabCommand}"
                            CommandParameter="1" Margin="0,2,0,0" ToolTip="{loc:Tr '작업 로그'}">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconList}" />
                    </Button>
                    <Border Style="{StaticResource Chip}" Padding="5,1" HorizontalAlignment="Center" Margin="0,2,0,0"
                            Visibility="{Binding RepoActivity.Count, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="{Binding RepoActivity.Count}" Style="{StaticResource ChipText}" />
                    </Border>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ShowRightTabCommand}"
                            CommandParameter="2" Margin="0,4,0,0" ToolTip="{loc:Tr '시스템 작업 로그'}">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconDesktop}" />
                    </Button>
                    <Border Style="{StaticResource Chip}" Padding="5,1" HorizontalAlignment="Center" Margin="0,2,0,0"
                            Visibility="{Binding Activity.Count, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="{Binding Activity.Count}" Style="{StaticResource ChipText}" />
                    </Border>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ShowRightTabCommand}"
                            CommandParameter="3" Margin="0,4,0,0" ToolTip="{loc:Tr '시스템 오류'}">
                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconStop}" />
                    </Button>
                    <Border Style="{StaticResource Chip}" Padding="5,1" HorizontalAlignment="Center" Margin="0,2,0,0"
                            Visibility="{Binding ErrorLog.TotalCount, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="{Binding ErrorLog.TotalCount}" Style="{StaticResource ChipText}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!--
          일괄 작업 띠 — 유형별 묶음 넷이 왼쪽부터 선다: 1 브랜치 → 2 받기 → 3 병합(가져오는 쪽) → 4 올리기(내보내는 쪽).
          계약: 브랜치는 전부 고르는 상자다 — 펼 때 저장소들의 브랜치 이름을 읽어 채운다(MainViewModel.Branches.cs).
        -->
        <Border x:Name="ActionBar" Grid.Row="2" Style="{StaticResource RaisedCard}" Margin="12,8,12,12" Padding="12,8">
                <!-- 계약: 묶음은 일하는 차례대로 왼쪽부터 선다 — 1 브랜치 · 2 받기 · 3 병합 · 4 올리기. 묶음마다 머리 한 줄 + 두 줄이다 -->
                <!-- 계약: 네 묶음의 두 줄은 높이를 함께 쓴다(SharedSizeGroup) — 묶음마다 아래 여백이 달라지지 않는다 -->
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="430" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 계약: 이 줄의 묶음 셋의 폭 합 + 올리기 묶음의 최소 폭이 창의 최소 폭이다(MainWindow.OnActionTopRowSizeChanged) -->
                    <StackPanel x:Name="ActionTopRow" Orientation="Horizontal" SizeChanged="OnActionTopRowSizeChanged">
                        <!-- 브랜치 — 공통 값. 저장소별 값은 줄의 톱니에서 고른다 -->
                        <Border Style="{StaticResource ActionGroup}" Margin="0,0,8,0">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="1" Style="{StaticResource ChipText}" />
                                </Border>
                                <TextBlock Text="{loc:Tr '브랜치'}" Style="{StaticResource SectionTitle}" Margin="0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="ActionRowTop" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="Auto" SharedSizeGroup="ActionRowBottom" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{loc:Tr '작업 브랜치'}" Style="{StaticResource Micro}" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" MinWidth="150" MaxDropDownHeight="320"
                                              ItemsSource="{Binding WorkBranchOptions}" SelectedValuePath="Value"
                                              DisplayMemberPath="Label" SelectedValue="{Binding WorkBranch}"
                                              DropDownOpened="OnBranchDropDownOpened"
                                              ToolTip="{loc:Tr '내가 일하는 브랜치입니다 — 지금 브랜치가 이것과 다른 저장소는 병합·커밋·올리기를 건너뜁니다. 저장소별로는 줄의 톱니에서 따로 고릅니다'}" />
                                    <Button Grid.Column="2" Content="{loc:Tr 'Switch'}" Command="{Binding SwitchToWorkCommand}" Margin="5,0,0,0"
                                            controls:Nudge.Key="switch" controls:Nudge.Active="{Binding NudgeAction}"
                                            ToolTip="{loc:Tr '고른 저장소의 체크아웃을 작업 브랜치로 바꿉니다 — 그 브랜치가 없는 저장소는 그대로 두고, 변경한 파일이 겹치면 옮기지 않습니다'}" />
                                    <TextBlock Grid.Row="2" Text="{loc:Tr '업로드 브랜치'}" Style="{StaticResource Micro}" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="150" MaxDropDownHeight="320"
                                              ItemsSource="{Binding UploadBranchOptions}" SelectedValuePath="Value"
                                              DisplayMemberPath="Label" SelectedValue="{Binding UploadBranch}"
                                              DropDownOpened="OnBranchDropDownOpened"
                                              ToolTip="{loc:Tr '코드가 모이는 브랜치입니다 — 병합이 여기서 받아 오고 올리기가 여기로 올립니다. 저장소별로는 줄의 톱니에서 따로 고릅니다'}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Fetch · Pull — 윗줄은 작업(지금) 브랜치, 아랫줄은 업로드·그 밖의 브랜치 -->
                        <Border Style="{StaticResource ActionGroup}" Margin="0,0,8,0">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="2" Style="{StaticResource ChipText}" />
                                </Border>
                                <TextBlock Text="{loc:Tr 'Fetch · Pull'}" Style="{StaticResource SectionTitle}" Margin="0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="ActionRowTop" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="Auto" SharedSizeGroup="ActionRowBottom" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{loc:Tr '작업'}" Style="{StaticResource Micro}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{loc:Tr '현재 브랜치 Pull'}" Command="{Binding PullCurrentCommand}" />
                                    <Button Grid.Column="3" Content="{loc:Tr '전체 Fetch'}" Command="{Binding FetchCommand}"
                                            ToolTip="{loc:Tr '원격만 읽습니다 — 작업 트리를 건드리지 않습니다'}" />
                                    <TextBlock Grid.Row="2" Text="{loc:Tr '업로드'}" Style="{StaticResource Micro}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="1" Content="{loc:Tr '업로드 브랜치 Fetch'}" Command="{Binding UpdateDefaultCommand}"
                                            ToolTip="{loc:Tr '체크아웃을 바꾸지 않고 로컬의 업로드 브랜치만 빨리감기로 갱신합니다'}" />
                                    <Button Grid.Row="2" Grid.Column="3" Content="{loc:Tr '추적 브랜치 전체 Fetch'}" Command="{Binding UpdateAllBranchesCommand}"
                                            ToolTip="{loc:Tr '뒤처진 브랜치만 빨리감기로 갱신하고, 갈라진 것은 건너뜁니다'}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 병합 — 위에서 가져올 브랜치를 고르고 아래에서 합친다. 되돌리기를 바로 옆에 둔다 -->
                        <Border Style="{StaticResource ActionGroup}" Margin="0,0,8,0">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="3" Style="{StaticResource ChipText}" />
                                </Border>
                                <TextBlock Text="{loc:Tr 'Merge'}" Style="{StaticResource SectionTitle}" Margin="0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="ActionRowTop" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="Auto" SharedSizeGroup="ActionRowBottom" />
                                    </Grid.RowDefinitions>
                                    <ComboBox Grid.ColumnSpan="3" MaxDropDownHeight="320"
                                              ItemsSource="{Binding MergeSourceOptions}" SelectedValuePath="Value"
                                              DisplayMemberPath="Label" SelectedValue="{Binding MergeSource}"
                                              DropDownOpened="OnBranchDropDownOpened"
                                              ToolTip="{loc:Tr '지금 브랜치로 가져올 브랜치입니다 — 「업로드 브랜치」면 저장소마다 정해 둔 업로드 브랜치를 가져옵니다'}" />
                                    <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Command="{Binding MergeDefaultCommand}"
                                            controls:Nudge.Key="merge" controls:Nudge.Active="{Binding NudgeAction}"
                                            ToolTip="{loc:Tr '고른 브랜치를 원격에서 받아 저장소마다 지금 브랜치로 병합합니다 — 충돌하면 멈추고 알려 줍니다'}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconMerge}" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:Tr '지금 브랜치로 Merge'}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DangerButton}" Command="{Binding AbortCommand}"
                                            ToolTip="{loc:Tr '진행 중인 병합·리베이스를 취소합니다'}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconUndo}" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:Tr 'Merge 취소'}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 올리기 — 왼쪽에 커밋 글 두 줄, 오른쪽에 그 글을 쓰는 단추 -->
                    <Border Grid.Column="1" Style="{StaticResource ActionGroup}">
                        <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="4" Style="{StaticResource ChipText}" />
                            </Border>
                            <TextBlock Text="{loc:Tr 'Commit · Push'}" Style="{StaticResource SectionTitle}" Margin="0"
                                       VerticalAlignment="Center" />
                            <!-- 계약: 커밋은 됐는데 Push 되지 않은 저장소가 있을 때만 보인다 — 누르면 저장소별 층이 뜬다 -->
                            <Button x:Name="PushGapButton" Style="{StaticResource GhostButton}" Padding="7,0" Margin="10,-5,0,-5"
                                    VerticalAlignment="Center" Command="{Binding OpenPushGapCommand}"
                                    Visibility="{Binding PushGapCount, Converter={StaticResource CountToVisibility}}"
                                    ToolTip="{loc:Tr '커밋은 됐지만 아직 Push 되지 않은 저장소를 저장소별로 보여 줍니다'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr 'Push 전'}" FontSize="{StaticResource FontXs}"
                                               Foreground="{DynamicResource AheadBrush}" />
                                    <TextBlock Text="{Binding PushGapCount}" FontSize="{StaticResource FontXs}" FontWeight="Bold"
                                               Foreground="{DynamicResource AheadBrush}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                            <!-- 계약: 자리표 {기능} · {그룹} · {저장소} 는 단추를 누를 때 채워진다 — 글상자에는 자리표째 남는다 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="ActionRowTop" />
                                    <RowDefinition Height="5" />
                                    <RowDefinition Height="Auto" SharedSizeGroup="ActionRowBottom" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Tr '커밋 제목'}" Style="{StaticResource Micro}" Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Tag="{loc:Tr '커밋 첫 줄 — 고른 저장소에 모두 같은 제목으로 들어갑니다'}"
                                         ToolTip="{Binding CommitTokenHint}"
                                         Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Text="{loc:Tr '메시지'}" Style="{StaticResource Micro}" Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Tag="{loc:Tr '커밋 본문 — 비우면 제목만 들어갑니다'}"
                                         ToolTip="{Binding CommitTokenHint}"
                                         Text="{Binding CommitBody, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="2" Content="{loc:Tr '커밋'}" Command="{Binding CommitCommand}" Margin="8,0,0,0" />
                                <Button Grid.Column="3" Content="{loc:Tr 'Push'}" Command="{Binding PushCommand}" Margin="5,0,0,0"
                                        ToolTip="{loc:Tr '업로드 브랜치로 올립니다 — 업로드 브랜치를 안 정한 저장소는 지금 브랜치 이름 그대로 올립니다'}" />
                                <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CommitAndPushCommand}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconUp}" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Tr '커밋 + Push'}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"
                            Margin="8,0,0,0" VerticalAlignment="Bottom" IsEnabled="{Binding IsBusy}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconStop}" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Tr '멈추기'}" />
                        </StackPanel>
                    </Button>
                </Grid>
        </Border>

        </Grid>

        <!-- ── 대시보드 ────────────────────────────────────── -->
        <!-- 계약: 그림·배치는 Views/DashboardView.xaml 이 갖는다 — 여기는 어느 화면일 때 보이는지만 정한다 -->
        <views:DashboardView x:Name="DashboardPage" Margin="12"
                             Visibility="{Binding PageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}" />

        <!-- ── 커밋 내역 ───────────────────────────────────── -->
        <!-- 계약: 대시보드 커밋 캘린더의 칸·막대를 누르면 채워진다(MainViewModel.History.cs) — 읽기뿐이고 웹은 단추를 눌렀을 때만 연다 -->
        <Border x:Name="HistoryPage" Style="{StaticResource Card}" Margin="12" Padding="14,12"
                Visibility="{Binding PageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding HistoryTitle}" Style="{StaticResource Subtitle}" />
                    <TextBlock Text="{Binding HistoryCaption}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding HistoryCommits}"
                         ItemContainerStyle="{Binding Settings.CompactRows, Converter={StaticResource RowStyle}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="18*" MinWidth="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="56*" />
                                    <ColumnDefinition Width="14*" MinWidth="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WhenText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding RepoName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Group}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding ShortSha}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Commit.Subject}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Commit.Subject}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="4" Text="{Binding Commit.Author}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Style="{StaticResource GhostButton}" Padding="7,3" Content="{loc:Tr '웹에서 보기'}"
                                            ToolTip="{Binding WebUrl}"
                                            Command="{Binding DataContext.OpenCommitWebCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource GhostButton}" Padding="7,3" Margin="4,0,0,0" Content="{loc:Tr '저장소 보기'}"
                                            Command="{Binding DataContext.GoToCommitRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ── 점검 ───────────────────────────────────────── -->
        <!-- 계약: 표는 읽기 전용 보고다(MainViewModel.Audit.cs) — 쓰는 것은 위쪽 「작성자 일괄 적용」 하나뿐이고 미리 보기를 거친다 -->
        <Border x:Name="AuditPage" Style="{StaticResource Card}" Margin="12" Padding="14,12"
                Visibility="{Binding PageIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="{loc:Tr '점검 실행'}" VerticalAlignment="Top"
                            Command="{Binding RunAuditCommand}" />
                    <StackPanel>
                        <TextBlock Text="{loc:Tr '전체 저장소 점검'}" Style="{StaticResource Subtitle}" />
                        <TextBlock Text="{Binding AuditCaption}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <!-- 작성자 일괄 적용 — 이 화면에서 유일하게 쓰는 기능이다. 미리 보기에 오른 저장소에만, 로컬 설정에만 쓴다 -->
                <Border x:Name="AuditTools" Grid.Row="1" Margin="0,0,0,10" Padding="10,8" CornerRadius="{StaticResource RadiusSm}"
                        BorderThickness="1" BorderBrush="{DynamicResource SubtleOverlayBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20*" MinWidth="120" />
                                <ColumnDefinition Width="30*" MinWidth="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr '작성자 일괄 적용'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Tag="{loc:Tr '이름'}" Margin="0,0,6,0"
                                     Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Tag="{loc:Tr '메일'}" Margin="0,0,6,0"
                                     Text="{Binding AuthorEmail, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="3" Content="{loc:Tr '미리 보기'}" Margin="0,0,6,0"
                                    Command="{Binding PreviewAuthorCommand}" />
                            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="{loc:Tr '적용'}"
                                    Command="{Binding ApplyAuthorCommand}"
                                    Visibility="{Binding AuthorPreview.Count, Converter={StaticResource CountToVisibility}}" />
                            <TextBlock Grid.Column="5" Text="{Binding AuthorCaption}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                        <ScrollViewer MaxHeight="132" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding AuthorPreview.Count, Converter={StaticResource CountToVisibility}}">
                            <ItemsControl ItemsSource="{Binding AuthorPreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20*" MinWidth="150" />
                                                <ColumnDefinition Width="40*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="40*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="→" Style="{StaticResource Caption}" Margin="8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding After}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource WarnBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 공통 무시 목록 — 고른 저장소의 .git/info/exclude 에 없는 줄만 덧붙인다(MainViewModel.Exclude.cs) -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50*" MinWidth="280" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Tr '공통 무시 목록'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Top"
                                       Margin="0,8,10,0" />
                            <TextBox Grid.Column="1" Tag="{loc:Tr '한 줄에 하나 — 예: .vs/'}" Margin="0,0,6,0" Height="64"
                                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="{loc:Tr '미리 보기'}" Margin="0,0,6,0" VerticalAlignment="Top"
                                    Command="{Binding PreviewExcludeCommand}" />
                            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="{loc:Tr '적용'}" VerticalAlignment="Top"
                                    Command="{Binding ApplyExcludeCommand}"
                                    Visibility="{Binding ExcludePreview.Count, Converter={StaticResource CountToVisibility}}" />
                            <StackPanel Grid.Column="4" Margin="12,6,0,0" VerticalAlignment="Top">
                                <CheckBox x:Name="ExcludeToGitignoreBox" Content="{loc:Tr '.gitignore 에 쓰기 — 커밋되는 파일'}"
                                          IsChecked="{Binding ExcludeToGitignore}" />
                                <TextBlock Text="{Binding ExcludeCaption}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer MaxHeight="132" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding ExcludePreview.Count, Converter={StaticResource CountToVisibility}}">
                            <ItemsControl ItemsSource="{Binding ExcludePreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20*" MinWidth="150" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="80*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="+" Style="{StaticResource Caption}" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding MissingText}" Style="{StaticResource Mono}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding MissingText}"
                                                       Foreground="{DynamicResource WarnBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="10,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16*" MinWidth="150" />
                        <ColumnDefinition Width="8*" MinWidth="80" />
                        <ColumnDefinition Width="22*" />
                        <ColumnDefinition Width="24*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="30*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Tr '저장소'}" Style="{StaticResource Micro}" />
                    <TextBlock Grid.Column="1" Text="{loc:Tr '브랜치'}" Style="{StaticResource Micro}" />
                    <TextBlock Grid.Column="2" Text="{loc:Tr '작성자'}" Style="{StaticResource Micro}" />
                    <TextBlock Grid.Column="3" Text="{loc:Tr '원격'}" Style="{StaticResource Micro}" />
                    <TextBlock Grid.Column="4" Text="autocrlf" Style="{StaticResource Micro}" />
                    <TextBlock Grid.Column="5" Text="{loc:Tr '무시 · exclude'}" Style="{StaticResource Micro}" />
                    <TextBlock Grid.Column="6" Text="{loc:Tr '마지막 Fetch'}" Style="{StaticResource Micro}" />
                    <TextBlock Grid.Column="7" Text="{loc:Tr '확인할 것'}" Style="{StaticResource Micro}" />
                </Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding AuditRows}"
                         ItemContainerStyle="{Binding Settings.CompactRows, Converter={StaticResource RowStyle}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16*" MinWidth="150" />
                                    <ColumnDefinition Width="8*" MinWidth="80" />
                                    <ColumnDefinition Width="22*" />
                                    <ColumnDefinition Width="24*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="30*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RepoName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Group}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding BranchText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Author}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Author}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="3" Text="{Binding RemoteText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RemoteText}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="4" Text="{Binding AutoCrlfText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding IgnoreText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding FetchText}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="7" Text="{Binding FindingText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FindingText}" Margin="0,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFindings}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="8" Style="{StaticResource GhostButton}" Padding="7,3" Content="{loc:Tr '저장소 보기'}"
                                        Command="{Binding DataContext.GoToAuditRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        </Grid>

        <!-- ④ 상태 줄 -->
        <!-- 계약: 늘 보이는 한 줄이다 — 왼쪽은 하는 일(없으면 「준비」)과 진행 막대, 오른쪽은 마지막 갱신·다음 자동 갱신(RefreshLine) -->
        <!-- 왜: 일할 때만 뜨는 띠는 뜰 때마다 화면을 밀었다 — 자리를 고정해 막대만 나타났다 사라지게 한다(2026-10-11 사용자 지시) -->
        <Border x:Name="StatusBar" Grid.Row="3" Height="28" Padding="16,0" SnapsToDevicePixels="True"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 계약: 창 우측 하단의 앱 버전 — 080.CS앱-화면-공통.md §5 -->
                <TextBlock Grid.Column="4" Text="{x:Static core:AppVersion.Label}" Style="{StaticResource Micro}"
                           VerticalAlignment="Center" Margin="14,0,0,0" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkingNow}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusBarText}" Style="{StaticResource Caption}"
                               FontSize="{StaticResource FontXs}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                            Visibility="{Binding ProgressTotal, Converter={StaticResource CountToVisibility}}">
                    <ProgressBar Width="220" Height="4" VerticalAlignment="Center"
                                 Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone}" />
                    <TextBlock Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="{Binding ProgressDone, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding ProgressTotal, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- 계약: 가장 최근 작업 기록 한 줄 — 일괄 작업이 도는 동안에는 저장소마다 끝나는 대로 바뀐다. 전체는 오른쪽 단 「작업 로그」에 있다 -->
                <DockPanel Grid.Column="2" Margin="18,0" VerticalAlignment="Center">
                    <!-- 계약: 실패 기록이 있을 때만 보인다 - 실패 기록 + 환경·설정 + 이벤트 로그를 복사하고 이슈 양식을 연다(MainViewModel.Report.cs) -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="7,1" MinHeight="20" Margin="10,0,0,0"
                            Command="{Binding ReportErrorCommand}"
                            Visibility="{Binding HasReportableError, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{loc:Tr '실패한 작업 기록 · 환경 · 설정 · 이벤트 로그를 한 벌로 복사하고 이슈 양식을 엽니다 — 저장소 경로와 원격 주소는 가립니다'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconCopy}" Width="11" Height="11" Margin="0,0,5,0" />
                            <TextBlock Text="{loc:Tr '오류 보고'}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Micro}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding LastActivityLine}" ToolTip="{Binding LastActivity.Message}"
                               Foreground="{Binding LastActivity.Outcome, Converter={StaticResource OutcomeBrush}}" />
                </DockPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="{loc:Tr 'F5 로 바로 갱신합니다 — 주기는 설정의 동기화 탭에서 바꿉니다'}"
                            Visibility="{Binding RefreshLine, Converter={StaticResource EmptyToVisibility}}">
                    <TextBlock Text="{Binding RefreshLine}" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="5,0"
                            Background="{DynamicResource SubtleOverlayBrush}">
                        <TextBlock Text="F5" Style="{StaticResource Micro}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 계약: 커밋 · Push 앞뒤의 확인 층 둘 — 평소에는 접혀 있다(그림은 각 파일, 값은 MainViewModel.PushCheck.cs) -->
        <views:PushGapLayer Grid.RowSpan="4" />
        <views:OffBranchLayer Grid.RowSpan="4" />
        <!-- 계약: 원격 없는 저장소를 GitHub 에 올리는 층 — 값은 MainViewModel.Publish.cs -->
        <views:PublishLayer Grid.RowSpan="4" />

        <!-- ⑤ 도움말 안내 층 — 평소에는 접혀 있고 「도움말」이 펴서 화면 요소를 차례로 비춘다(MainWindow.Tour.cs) -->
        <controls:TourOverlay x:Name="Tour" Grid.RowSpan="4" Visibility="Collapsed" />
    </Grid>
</Window>
