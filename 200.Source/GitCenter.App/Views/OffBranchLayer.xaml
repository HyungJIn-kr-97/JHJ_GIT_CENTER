<UserControl x:Class="GitCenter.App.Views.OffBranchLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Jhj.Core.Wpf.Localization;assembly=Jhj.Core.Wpf"
             xmlns:vm="clr-namespace:GitCenter.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Visibility="{Binding IsOffBranchOpen, Converter={StaticResource BoolToVisibility}}">

    <!--
      커밋 · Push 전의 확인 층 - 지금 브랜치가 작업 브랜치가 아닌 저장소를 모아 저장소별로 묻는다(MainViewModel.PushCheck.cs).
      계약: 체크한 저장소만 지금 브랜치 그대로 진행한다 - 체크는 기본이 꺼짐이고, 「취소」는 일괄 작업을 통째로 그만둔다.
      계약: 폭은 창의 절반(별 비율)이고 px 는 하한뿐이다 - 목록이 길면 카드 안에서만 스크롤한다.
    -->
    <Grid Background="{StaticResource ScrimBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" MinWidth="560" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Grid.Row="1" VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="18,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{Binding OffBranchCaption}" Style="{StaticResource Subtitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="{loc:Tr '체크한 저장소는 지금 브랜치 그대로 진행합니다. 체크하지 않은 저장소는 건너뜁니다.'}" />
                </StackPanel>

                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Content="{loc:Tr '모두 체크'}"
                            Command="{Binding CheckAllOffBranchCommand}" />
                    <Button Grid.Column="2" Content="{loc:Tr '취소'}" Command="{Binding CancelOffBranchCommand}"
                            IsCancel="True" />
                    <Button Grid.Column="3" Style="{StaticResource PushButton}" Margin="6,0,0,0"
                            Content="{loc:Tr '진행'}" Command="{Binding ProceedOffBranchCommand}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding OffBranchRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SubtleOverlayBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Group}" Style="{StaticResource Micro}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{loc:Tr '지금 브랜치'}" Foreground="{DynamicResource TextMutedBrush}" />
                                                <Run Text="{Binding Current, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource WarnBrush}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Micro}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{loc:Tr '작업 브랜치'}" />
                                                <Run Text="{Binding Work, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding StateText}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
