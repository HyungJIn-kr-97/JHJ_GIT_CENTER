<Window x:Class="GitCenter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Jhj.Core.Wpf.Localization;assembly=Jhj.Core.Wpf"
        xmlns:core="clr-namespace:Jhj.Core.App;assembly=Jhj.Core"
        xmlns:vm="clr-namespace:GitCenter.App.ViewModels"
        xmlns:tabs="clr-namespace:GitCenter.App.Views.SettingsTabs"
        xmlns:deploy="clr-namespace:Jhj.Core.Wpf.Deploy;assembly=Jhj.Core.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JHJ Git Center — 설정"
        Width="980" Height="780" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}">

    <!-- 함정: ShowInTaskbar 를 켜 두면 이 창이 떠 있는 동안 작업 표시줄이 이 창의 아이콘(exe 내장 그림)을 보여, 설정에서 고른 아이콘이 작업 표시줄에만 안 비친다 -->

    <!-- 계약: 본 창과 같다 — Windows 제목 표시줄을 떼고 머리 줄이 그 일을 한다(MainWindow.xaml 의 설명 참고) -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 머리 — 이름표 한 줄. 끌면 창이 따라온다 -->
        <Grid Margin="2,0,0,12" Background="Transparent" MouseLeftButtonDown="OnCaptionMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center">
                    <Path Data="{StaticResource IconGear}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr '설정'}" Style="{StaticResource Subtitle}" />
                    <TextBlock Style="{StaticResource Micro}" Margin="0,1,0,0"
                               Text="%LOCALAPPDATA%\JHJ_Git-Center\settings.json 한 파일에 저장됩니다" />
                </StackPanel>
            </StackPanel>
            <!-- 「앱 공유하기」 — 030.설정-창-기본-규격.md §1. 계약: 「배포하기」는 개발 장비 + 저장소 소유자 계정일 때만 보인다(Core AppDeploy) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="{loc:Tr '앱 공유하기'}" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <!-- 계약: 셋의 순서와 뜻은 AI 사용량과 같다 — winget 명령 복사 · 설치 파일 주소 복사 · 설치 파일 내려받기(주소는 Core AppLinks) -->
                <Button x:Name="ShareWingetButton" Style="{StaticResource IconButton}" Click="OnShareWingetClick"
                        ToolTip="{loc:Tr 'winget 설치 명령 복사 — 터미널에 붙여 넣으면 설치됩니다'}">
                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconTerminal}" />
                </Button>
                <Button x:Name="ShareLinkButton" Style="{StaticResource IconButton}" Click="OnShareLinkClick"
                        ToolTip="{loc:Tr '설치 파일 주소 복사 — 받는 사람은 언제나 최신 설치 파일을 받습니다'}">
                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconLink}" />
                </Button>
                <Button x:Name="ShareDownloadButton" Style="{StaticResource IconButton}" Click="OnShareDownloadClick"
                        ToolTip="{loc:Tr '설치 파일 내려받기 — 브라우저로 최신 설치 파일을 받습니다'}">
                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconDownload}" />
                </Button>
                <Button x:Name="ShareDeployButton" Style="{StaticResource IconButton}" Click="OnShareDeployClick" Visibility="Collapsed"
                        Foreground="{DynamicResource AccentBrush}"
                        ToolTip="{loc:Tr '배포하기 — 버전을 고르면 이 화면에서 진행이 보입니다. 계정과 이 장비가 배포 이력에 남습니다'}">
                    <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconUpload}" />
                </Button>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick"
                    VerticalAlignment="Top" Margin="0,-4,-4,0" ToolTip="{loc:Tr '닫기'}">
                <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource IconClose}" />
            </Button>
        </Grid>

        <TabControl Grid.Row="1">
            <!-- 계약: 공통 탭 「일반」·「화면」·「아이콘」이 먼저, 세로 금 뒤에 앱 전용 탭이 온다 — 030.설정-창-기본-규격.md §1 -->
            <TabItem Header="일반"><tabs:GeneralTab /></TabItem>
            <TabItem Header="화면"><tabs:DisplayTab /></TabItem>
            <TabItem Header="아이콘"><tabs:IconTab /></TabItem>
            <TabItem Style="{StaticResource TabGroupDivider}" />
            <TabItem Header="목록 출처"><tabs:SourcesTab /></TabItem>
            <TabItem Header="동기화"><tabs:SyncTab /></TabItem>
            <TabItem Header="git 동작"><tabs:GitTab /></TabItem>
        </TabControl>

        <!-- 계약: 배포 화면은 탭 자리를 덮는 별개 화면이다 — 머리 줄의 「배포하기」가 여닫고, 열려 있는 동안 그 단추에 강조색 바탕이 든다(030 규격 §1-1) -->
        <!-- 계약: 몸통은 Core 의 DeployPanel 이다 — 단추·콤보·체크는 이 앱의 암묵 스타일을 그대로 받는다 -->
        <Border x:Name="DeployHost" Grid.Row="1" Background="{DynamicResource BgBrush}" Padding="2,0,2,0" Visibility="Collapsed">
            <deploy:DeployPanel x:Name="DeployView" Foreground="{DynamicResource TextPrimaryBrush}"
                                AccentBrush="{DynamicResource AccentBrush}" LineBrush="{DynamicResource DividerBrush}" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource HDivider}" Margin="0,12,0,0" VerticalAlignment="Top" />
        <!-- 계약: 단추가 오른쪽을 쓰므로 버전은 바닥 왼쪽이다 — 080.CS앱-화면-공통.md §5 -->
        <TextBlock Grid.Row="2" Text="{x:Static core:AppVersion.Label}" Style="{StaticResource Micro}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,22,0,0" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,2,0">
            <TextBlock Text="{Binding TestResult}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Margin="0,0,14,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <Button Content="{loc:Tr '적용'}" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                    Margin="0,0,6,0" MinWidth="96" />
            <Button Content="{loc:Tr '닫기'}" Click="OnCloseClick" MinWidth="96" />
        </StackPanel>
    </Grid>
</Window>
